{
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.netrc)",
      "Read(**/*kubeconfig*)",
      "Read(**/.docker/config.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.cache/huggingface/token)",
      "Read(~/.config/gh/hosts.yml)",
      "Bash(*.env*)",
      "Bash(*.pem*)",
      "Bash(*.key)",
      "Bash(*.key *)",
      "Bash(*.p12*)",
      "Bash(*.pfx*)",
      "Bash(*id_rsa*)",
      "Bash(*id_ecdsa*)",
      "Bash(*id_ed25519*)",
      "Bash(*.netrc*)",
      "Bash(*kubeconfig*)",
      "Bash(*.ssh/*)",
      "Bash(*.aws/*)",
      "Bash(*.kube/*)",
      "Bash(*.docker/config.json*)",
      "Bash(*huggingface/token*)",
      "Bash(*gh/hosts.yml*)",
      "Bash(gh auth token*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * :*)",
      "Bash(git tag -d*)",
      "Bash(git tag -f*)",
      "Bash(git tag --delete*)",
      "Bash(git tag --force*)"
    ]
  }
}
