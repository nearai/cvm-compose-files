diff --git a/vllm/entrypoints/serve/exception_handling/utils.py b/vllm/entrypoints/serve/exception_handling/utils.py
index 1c26c90..6bdd735 100644
--- a/vllm/entrypoints/serve/exception_handling/utils.py
+++ b/vllm/entrypoints/serve/exception_handling/utils.py
@@ -11,6 +11,11 @@ def sanitize_message(message: str) -> str:
     message = re.sub(
         r"/(?:home|usr|opt|var|tmp|root|lib|mnt|srv)(?:/[\w.\-]+)+", "<path>", message
     )
-    if "." in message:
-        message = re.sub(r"(?>/[\w\-]+)+/[\w\-]+\.\w+", "<path>", message)
+    # Match each run of /segments whole and check for an extension afterwards:
+    # requiring it inside the pattern backtracks superlinearly on long runs.
+    message = re.sub(
+        r"(?:/[\w\-]+)+(\.\w+)?",
+        lambda m: "<path>" if m[1] and m[0].count("/") > 1 else m[0],
+        message,
+    )
     return message.strip()
