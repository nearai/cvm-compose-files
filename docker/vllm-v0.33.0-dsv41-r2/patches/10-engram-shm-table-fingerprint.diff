         return torch.from_numpy(np.frombuffer(self._near_mapping, dtype=np.uint8))
 
+    def _near_verify(self) -> None:
+        """The ready markers say a load finished, not that these are still its bytes."""
+        try:
+            with open(self._near_path + ".id") as file:
+                want = file.read().strip()
+        except OSError:
+            want = None
+        if want == _near_fingerprint(self._near_mapping):
+            return
+        for suffix in (".id", *(f".{p}.ready" for p in _NEAR_READY)):
+            try:
+                os.unlink(self._near_path + suffix)
+            except OSError:
+                pass
+        raise RuntimeError(
+            "NEAR Engram: the shared table does not match the fingerprint it was loaded "
+            "with. Its markers are cleared, so the next start loads the table again."
+        )
