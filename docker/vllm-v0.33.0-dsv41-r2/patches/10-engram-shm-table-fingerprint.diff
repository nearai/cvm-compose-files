 # buffers, async H2D. Copies only: the GPU still never reads host memory.
 _NEAR_FAST_GATHER = _NEAR_CPU_GATHER and os.environ.get("VLLM_NEAR_ENGRAM_FAST_GATHER") == "1"
 _NEAR_READY = ("w", "s")
+_NEAR_SAMPLE = 4 << 20
 
+
+def _near_fingerprint(mapping) -> str:
+    """Bounded content fingerprint of a shared Engram table.
+
+    Reuse exists to skip a reload, so this samples the head, middle and tail rather than
+    reading the whole table: enough to tell a different or truncated table apart.
+    """
+    num_bytes = len(mapping)
+    span = min(_NEAR_SAMPLE, num_bytes)
+    digest = hashlib.sha256(str(num_bytes).encode())
+    for start in (0, max(0, num_bytes // 2 - span // 2), num_bytes - span):
+        digest.update(mapping[start : start + span])
+    return digest.hexdigest()
+
 # Per-rank token slot from which the Engram DP exchange switches from peer
 # reads to all-to-all.
 ENGRAM_A2A_MIN_SLOT = 128
