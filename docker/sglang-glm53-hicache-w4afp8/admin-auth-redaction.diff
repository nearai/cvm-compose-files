 # --------------------------------------------------------------------------
 
 
+# Credentials -- the access keys and the TLS key's password: no readback, log or
+# dump of the configuration carries them (backport of upstream sglang #48518).
+SERVER_ARGS_SECRET_FIELD_NAMES = frozenset(
+    {"api_key", "admin_api_key", "ssl_keyfile_password"}
+)
+_SECRET_CLI_FLAGS = frozenset(
+    "--" + name.replace("_", "-") for name in SERVER_ARGS_SECRET_FIELD_NAMES
+)
+_REDACTED = "<redacted>"
+
+
+def redact_server_args_secrets(values: Dict[str, Any]) -> Dict[str, Any]:
+    """A copy of a server-args mapping with the credentials replaced. An unset
+    credential stays None, so readers can still tell whether one is set."""
+    redacted = dict(values)
+    for name in SERVER_ARGS_SECRET_FIELD_NAMES:
+        if redacted.get(name) is not None:
+            redacted[name] = _REDACTED
+    return redacted
+
+
+def redact_secret_cli_args(argv: List[str]) -> List[str]:
+    """``argv`` with the value of every credential flag replaced, in both the
+    ``--flag value`` and the ``--flag=value`` forms."""
+    out: List[str] = []
+    hide_next = False
+    for arg in argv:
+        if hide_next:
+            out.append(_REDACTED)
+            hide_next = False
+        elif arg in _SECRET_CLI_FLAGS:
+            out.append(arg)
+            hide_next = True
+        elif arg.split("=", 1)[0] in _SECRET_CLI_FLAGS and "=" in arg:
+            out.append(arg.split("=", 1)[0] + "=" + _REDACTED)
+        else:
+            out.append(arg)
+    return out
+
+
 @dataclasses.dataclass
 class ServerArgs:
     """Server-wide configuration for SGLang.
@@ -3723,6 +3763,22 @@
         # end of the pipeline that normally sets it: the gate is about whether
         # the handlers ran, not how far they got.
         self._resolution_finished = True
+
+    def __repr__(self) -> str:
+        # Defined in the class body, so @dataclass keeps it instead of
+        # generating one that would print the credentials.
+        values = ", ".join(
+            f"{field.name}="
+            + (
+                repr(_REDACTED)
+                if field.name in SERVER_ARGS_SECRET_FIELD_NAMES
+                and getattr(self, field.name, None) is not None
+                else repr(getattr(self, field.name, None))
+            )
+            for field in dataclasses.fields(self)
+            if field.repr
+        )
+        return f"{type(self).__name__}({values})"
 
