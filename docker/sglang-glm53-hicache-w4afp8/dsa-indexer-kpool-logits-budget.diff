+
+# The K-pool prefill paths score every query row against the whole gathered key buffer, so the fp32
+# logits scratch is rows x key_rows x 4 bytes. A 16K chunk on TP2 qsplit is 8192 rows per rank, so
+# with a long context the scratch reaches 10+ GiB and can exceed what mem_fraction_static leaves free
+# (prod gpu23 r1b, 2026-10-18 23:40 UTC). Score rows in blocks under the same budget the upstream
+# Indexer._get_topk_ragged path uses: min(free * F, (1 - mem_fraction_static) * total * F, 0.3 * total)
+# with F = SGLANG_DSA_MQA_LOGITS_FREE_MEM_FRACTION, measured once per device (mem_get_info syncs).
+_KPOOL_LOGITS_BYTES_PER_ELEM = 4
+_KPOOL_LOGITS_STATIC_SKIP_ELEMS = 8_000_000
+_KPOOL_LOGITS_BUDGET_BYTES: Dict[int, int] = {}
+# Test override in MiB (forces the blocked path on ordinary prompts); unset in production.
+_KPOOL_LOGITS_BUDGET_MB = int(os.environ.get("SGLANG_DSA_KPOOL_LOGITS_BUDGET_MB", "0"))
+
+
+def _kpool_logits_budget_bytes(device_index: int) -> int:
+    if _KPOOL_LOGITS_BUDGET_MB > 0:
+        return _KPOOL_LOGITS_BUDGET_MB << 20
+    cached = _KPOOL_LOGITS_BUDGET_BYTES.get(device_index)
+    if cached is not None:
+        return cached
+    from sglang.srt.runtime_context import get_schedule
+
+    fraction = envs.SGLANG_DSA_MQA_LOGITS_FREE_MEM_FRACTION.get()
+    total_mem = torch.cuda.get_device_properties(device_index).total_memory
+    budget = int(total_mem * 0.3)
+    mem_fraction_static = get_schedule().mem_fraction_static
+    if mem_fraction_static is not None:
+        budget = min(budget, int(total_mem * max(0.0, 1.0 - mem_fraction_static) * fraction))
+    if get_is_capture_mode():
+        return max(1, budget)
+    free_mem, _ = torch.cuda.mem_get_info(device_index)
+    budget = max(1, min(budget, int(free_mem * fraction)))
+    _KPOOL_LOGITS_BUDGET_BYTES[device_index] = budget
+    return budget
