+    def _kpool_logits_topk_rows(
+        self, q_fp8, weights, k_fp8, k_scale, ks, ke, pool_lens, seq_lens,
+        page_table, page_table_row_index, topk_offsets, out_rows,
+    ) -> torch.Tensor:
+        """fp8_mqa_logits + pooled top-k for these query rows, in row blocks whose logits fit the budget.
+
+        Rows are independent (each carries its own [ks, ke) key range and the logits keep every key
+        column), so blocking only bounds the scratch; the selected indices are the same as one call.
+        page_table is per request when page_table_row_index is given, else per row (as in qsplit).
+        """
+        n_rows, k_rows = q_fp8.shape[0], k_fp8.shape[0]
+        block = n_rows
+        if n_rows * k_rows >= _KPOOL_LOGITS_STATIC_SKIP_ELEMS:
+            budget = _kpool_logits_budget_bytes(q_fp8.device.index)
+            block = max(1, min(n_rows, budget // max(1, k_rows * _KPOOL_LOGITS_BYTES_PER_ELEM)))
+        kv = (k_fp8.contiguous(), k_scale.contiguous())
+        if block >= n_rows:
+            logits = deep_gemm.fp8_mqa_logits(
+                q_fp8.contiguous(), kv, weights.contiguous(), ks, ke, clean_logits=True,
+            )
+            return self._topk_from_kpool_logits(
+                logits,
+                pool_lens,
+                seq_lens=seq_lens,
+                page_table=page_table,
+                topk_offsets=topk_offsets,
+                row_starts=ks,
+                out_rows=out_rows,
+                page_table_row_index=page_table_row_index,
+            )
+        out = None
+        for lo in range(0, n_rows, block):
+            hi = min(lo + block, n_rows)
+            logits = deep_gemm.fp8_mqa_logits(
+                q_fp8[lo:hi].contiguous(), kv, weights[lo:hi].contiguous(), ks[lo:hi], ke[lo:hi],
+                clean_logits=True,
+            )
+            part = self._topk_from_kpool_logits(
+                logits,
+                pool_lens[lo:hi],
+                seq_lens=seq_lens[lo:hi],
+                page_table=page_table if page_table_row_index is not None or page_table is None else page_table[lo:hi],
+                topk_offsets=None if topk_offsets is None else topk_offsets[lo:hi],
+                row_starts=ks[lo:hi],
+                page_table_row_index=None if page_table_row_index is None else page_table_row_index[lo:hi],
+            )
+            del logits
+            if out is None:
+                out = torch.full(
+                    (max(out_rows or n_rows, n_rows), part.shape[1]), -1, dtype=part.dtype, device=part.device
+                )
+            out[lo:hi] = part
+        return out
+
