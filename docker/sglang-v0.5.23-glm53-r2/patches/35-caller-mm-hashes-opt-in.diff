+def _trust_caller_mm_hashes() -> bool:
+    # A caller's hash becomes the item's prefix-cache identity; see tokenizer_manager.
+    from sglang.srt.utils import get_bool_env_var
+
+    return get_bool_env_var("SGLANG_TRUST_CALLER_MM_HASHES")
+
+
+def _trusted_caller_hash(value):
+    return value if _trust_caller_mm_hashes() else None
+
