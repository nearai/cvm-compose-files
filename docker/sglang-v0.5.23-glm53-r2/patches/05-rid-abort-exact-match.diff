diff --git a/test/registered/unit/managers/test_abort_rid_match.py b/test/registered/unit/managers/test_abort_rid_match.py
new file mode 100644
index 0000000000..733821aaee
--- /dev/null
+++ b/test/registered/unit/managers/test_abort_rid_match.py
@@ -0,0 +1,55 @@
+"""AbortReq rid matching (CVE-2026-112266).
+
+Upstream matched aborts with ``req.rid.startswith(abort.rid)``; a client that
+set a short ``rid`` and then disconnected aborted every other user's request
+whose rid shared that prefix. Matching is now exact, with the
+``<rid>_<i>`` batch children reachable only when the AbortReq opts in.
+"""
+
+import unittest
+from types import SimpleNamespace
+
+from sglang.srt.managers.abort_match import abort_req_matches, rid_matches_abort
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=2, suite="base-a-test-cpu")
+
+
+class TestRidMatchesAbort(unittest.TestCase):
+    def test_exact_match(self):
+        self.assertTrue(rid_matches_abort("a1b2", "a1b2"))
+
+    def test_short_client_rid_does_not_match_other_requests(self):
+        # e.g. uuid4().hex rids minted for other users.
+        for victim in ("a3f9c0de", "ab", "a_x", "a-0", "a_0"):
+            self.assertFalse(rid_matches_abort(victim, "a"), victim)
+
+    def test_empty_rid_matches_nothing(self):
+        self.assertFalse(rid_matches_abort("abc", ""))
+        self.assertFalse(rid_matches_abort("", ""))
+        self.assertFalse(rid_matches_abort("abc", None))
+
+    def test_abort_all(self):
+        self.assertTrue(rid_matches_abort("abc", "", abort_all=True))
+
+    def test_batch_children_only_on_request(self):
+        self.assertTrue(rid_matches_abort("X_0", "X", match_children=True))
+        self.assertTrue(rid_matches_abort("X_17", "X", match_children=True))
+        for other in ("X_", "X_a", "X_0_1", "X_١", "Xa_0", "X0"):
+            self.assertFalse(rid_matches_abort(other, "X", match_children=True), other)
+
+    def test_abort_req_wrapper(self):
+        exact = SimpleNamespace(rid="X", abort_all=False, match_children=False)
+        self.assertTrue(abort_req_matches(exact, "X"))
+        self.assertFalse(abort_req_matches(exact, "X_0"))
+        self.assertFalse(abort_req_matches(exact, "Xyz"))
+        parent = SimpleNamespace(rid="X", abort_all=False, match_children=True)
+        self.assertTrue(abort_req_matches(parent, "X_0"))
+        everything = SimpleNamespace(rid="", abort_all=True)
+        self.assertTrue(abort_req_matches(everything, "anything"))
+        # Duck-typed requests without the field fall back to exact matching.
+        self.assertFalse(abort_req_matches(SimpleNamespace(rid="X"), "X_0"))
+
+
+if __name__ == "__main__":
+    unittest.main()
