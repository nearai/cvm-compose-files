diff --git a/python/sglang/srt/managers/abort_match.py b/python/sglang/srt/managers/abort_match.py
new file mode 100644
index 0000000000..6594868ad0
--- /dev/null
+++ b/python/sglang/srt/managers/abort_match.py
@@ -0,0 +1,58 @@
+"""Which queued/running requests an AbortReq targets (CVE-2026-112266).
+
+Upstream matched with ``req.rid.startswith(abort.rid)``. A client can choose its
+own ``rid`` (OpenAI ``rid`` body field, ``x-override-rid`` header, ``/generate``),
+so a request with a short rid such as ``"a"`` followed by a client disconnect
+sent ``AbortReq(rid="a")`` and the scheduler aborted every other user's request
+whose server-minted uuid4-hex rid happened to start with ``a`` (1/16 of the
+fleet's traffic per hex digit).
+
+Every in-process abort producer (client disconnect, timeouts, session close,
+the scheduler itself) sends the exact rid of a request it owns, or
+``abort_all``. The only legitimate wider match is the batch expansion in
+``GenerateReqInput._normalize_rid``, which turns a string rid ``X`` for k
+prompts / n samples into children ``X_0 .. X_{k-1}``; an operator aborting
+``X`` through ``POST /abort_request`` on a tokenizer worker that does not own
+``X`` (multi-tokenizer mode) relies on reaching those children. That wider
+match is opt-in per AbortReq (``match_children``), set only by the tokenizer
+when it forwards an rid it does not own, so a client disconnect can never
+widen its abort beyond its own rid.
+
+Stdlib only, so it can be unit tested without the engine.
+"""
+
+from typing import Any, Optional
+
+
+def rid_matches_abort(
+    req_rid: Optional[str],
+    abort_rid: Optional[str],
+    *,
+    abort_all: bool = False,
+    match_children: bool = False,
+) -> bool:
+    if abort_all:
+        return True
+    if not isinstance(req_rid, str) or not isinstance(abort_rid, str):
+        return False
+    if not abort_rid:
+        # An empty rid must never match (upstream's startswith("") matched all).
+        return False
+    if req_rid == abort_rid:
+        return True
+    if match_children and req_rid.startswith(abort_rid + "_"):
+        suffix = req_rid[len(abort_rid) + 1 :]
+        # Only the `<rid>_<i>` children GenerateReqInput._normalize_rid mints.
+        return suffix.isascii() and suffix.isdigit()
+    return False
+
+
+def abort_req_matches(recv_req: Any, req_rid: Optional[str]) -> bool:
+    """Whether AbortReq ``recv_req`` targets the request whose rid is ``req_rid``."""
+    return rid_matches_abort(
+        req_rid,
+        getattr(recv_req, "rid", None),
+        # `is True`: tolerate duck-typed/mock AbortReqs without the field.
+        abort_all=getattr(recv_req, "abort_all", False) is True,
+        match_children=getattr(recv_req, "match_children", False) is True,
+    )
