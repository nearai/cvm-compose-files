new file mode 100644
index 0000000000..80a28d8daf
--- /dev/null
+++ b/python/sglang/srt/mem_cache/pooled_l2.py
@@ -0,0 +1,156 @@
+"""Opt-in rank-local pooled transfers for the GLM TP HiCache.
+
+DSA KV (including compatible packed MTP) uses byte-preserving
+gather/DMA/scatter through a persistent device staging buffer. Every other
+pool (DSA indexer, recurrent state, draft sidecars) keeps the upstream
+per-layer path. All ranks independently apply the same transfer plan; no
+cross-rank ownership.
+
+Port to v0.5.23: the host pools are built from device buffer infos, so the
+MLA host pool owns its device buffers (``device_kv_buffers``, host-layer
+order, packed MTP draft layers last) and the engine hands over resolved
+physical indices. The fork's recurrent-state duplicate-read GPU clone and the
+compressed-index pooled path are not carried (upstream state pools now also
+restore side-state buffers, and the indexer has its own host pool type).
+"""
+
+import logging
+import os
+
+import torch
+from sgl_kernel.kvcacheio import transfer_kv_direct  # noqa: F401  (CUDA build check)
+
+from sglang.srt.mem_cache.pool_host.mla import MLATokenToKVPoolHost
+from sglang.srt.mem_cache.pooled_pages import PooledPages
+
+logger = logging.getLogger(__name__)
+
+
+class PooledL2:
+    def __init__(self, io_backend):
+        if io_backend != "direct":
+            raise ValueError(
+                "SGLANG_HICACHE_POOLED_TRANSFERS=1 requires --hicache-io-backend direct"
+            )
+        if not torch.cuda.is_available() or torch.version.hip is not None:
+            raise ValueError("SGLANG_HICACHE_POOLED_TRANSFERS=1 requires NVIDIA CUDA")
+        self.backup_enabled = self.restore_enabled = True
+        self.pages = int(os.environ.get("SGLANG_HICACHE_STAGING_PAGES", "64"))
+        if not 1 <= self.pages <= 128:
+            raise ValueError("SGLANG_HICACHE_STAGING_PAGES must be in [1, 128]")
+        self.staging = {}
+        self.logged = set()
+
+    def _log_once(self, name):
+        if name not in self.logged:
+            logger.info("Pooled L2 transfer executed: %s", name)
+            self.logged.add(name)
+
+    @staticmethod
+    def _buffers(t):
+        """Device buffers in host-layer order, or None to use the upstream path."""
+        h = t.host_pool
+        if type(h) is not MLATokenToKVPoolHost:
+            return None
+        if (
+            getattr(h, "_is_dummy", False)
+            or h.layout != "page_first_direct"
+            or getattr(h, "dcp_size", 1) != 1
+            or getattr(h, "_layer_shard_enabled", False)
+            or getattr(h, "_native_buffers", None) is not None
+            or not h.device_rows_packed
+        ):
+            return None
+        if t.host_indices.device.type != "cpu" or t.device_indices.device.type != "cpu":
+            return None
+        if t.host_indices.dtype != torch.int64 or t.device_indices.dtype != torch.int64:
+            return None
+        buffers = tuple(h.device_kv_buffers)
+        if len(buffers) != h.layer_num:
+            return None
+        row_bytes = h.kv_cache_dim * h.dtype.itemsize
+        if any(
+            not b.is_cuda
+            or not b.is_contiguous()
+            or b.shape[0] % h.page_size
+            or b[0].nbytes != row_bytes
+            for b in buffers
+        ):
+            return None
+        if len({b.device for b in buffers}) != 1:
+            return None
+        if not h.kv_buffer.is_contiguous() or h.kv_buffer.shape[1] != h.layer_num:
+            return None
+        return buffers
+
+    def _stage(self, t, buffers, direction):
+        key = (id(t.host_pool), direction)
+        if key not in self.staging:
+            self.staging[key] = PooledPages(
+                list(buffers),
+                t.host_pool.kv_buffer,
+                tokens_per_page=t.host_pool.page_size,
+                staging_pages=self.pages,
+            )
+        return self.staging[key]
+
+    def backup(self, t):
+        """Back up every host layer (target + packed MTP) of one transfer."""
+        if not self.backup_enabled:
+            return False
+        buffers = self._buffers(t)
+        if buffers is None:
+            return False
+        self._stage(t, buffers, "D2H").transfer(
+            t.host_indices, t.device_indices, restore=False
+        )
+        self._log_once(type(t.host_pool).__name__ + "-pooled-D2H")
+        return True
+
+    def prepare_restore(self, transfers, transfer_layer_id_max):
+        """Restore complete packed pools up front; return the skipped indices.
+
+        Packed MTP uses extra L2Transfers for the same host pool and indices:
+        target layers map to their model positions, draft layers map to early
+        draft-consumer positions. Restore the complete packed pool once, before
+        either consumer, and only then skip every descriptor of that pool.
+        """
+        preloaded = set()
+        if not self.restore_enabled:
+            return preloaded
+        for i, t in enumerate(transfers):
+            if i in preloaded:
+                continue
+            buffers = self._buffers(t)
+            if buffers is None:
+                continue
+            h = t.host_pool
+            group = [
+                j
+                for j, other in enumerate(transfers)
+                if other.host_pool is h
+                and torch.equal(other.host_indices, t.host_indices)
+                and torch.equal(other.device_indices, t.device_indices)
+            ]
+            covered = []
+            for j in group:
+                other = transfers[j]
+                for n in range(transfer_layer_id_max):
+                    local = (
+                        other.layer_mapper(n) if other.layer_mapper is not None else n
+                    )
+                    if local is None:
+                        continue
+                    if not other.is_draft and local not in h._target_layer_indices:
+                        continue  # The upstream path skips these too.
+                    covered.append(h._host_layer_by_controller.get(local))
+            if sorted(covered, key=lambda x: -1 if x is None else x) != list(
+                range(h.layer_num)
+            ):
+                continue
+            self._stage(t, buffers, "H2D").transfer(
+                t.host_indices, t.device_indices, restore=True
+            )
+            preloaded.update(group)
+            self._log_once(type(h).__name__ + "-pooled-H2D")
+        return preloaded
diff --git a/python/sglang/srt/mem_cache/pooled_pages.py b/python/sglang/srt/mem_cache/pooled_pages.py
new file mode 100644
index 0000000000..ee3bed21c8
--- /dev/null
+++ b/python/sglang/srt/mem_cache/pooled_pages.py
@@ -0,0 +1,156 @@
+"""Rank-local, byte-preserving staging for page-first HiCache DMA.
+
+A separate persistent allocation per direction belongs to the L2 engine's
+single stream for that direction. CPU data is touched only by CUDA copies;
+Triton kernels gather/scatter device memory. This module owns no cache slots.
+"""
+
+import torch
+import triton
+import triton.language as tl
+from sgl_kernel.kvcacheio import transfer_kv_direct
+
+try:  # Added by the HCC managed-memory allocator patch.
+    from sglang.srt.mem_cache.pool_host.common import (
+        _cuda_managed_prefetch_pages_to_host,
+    )
+except ImportError:  # pragma: no cover - allocator patch absent
+
+    def _cuda_managed_prefetch_pages_to_host(*_args, **_kwargs):
+        return None
+
+
+
+@triton.jit
+def _pages_kernel(
+    ptrs,
+    pages,
+    staging,
+    ROW: tl.constexpr,
+    LAYERS: tl.constexpr,
+    BLOCK: tl.constexpr,
+    RESTORE: tl.constexpr,
+):
+    item = tl.program_id(0)
+    page = item // LAYERS
+    layer = item % LAYERS
+    offset = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    device_page = tl.load(pages + page)
+    base = tl.load(ptrs + layer).to(tl.pointer_type(tl.uint8))
+    device_ptr = base + device_page.to(tl.int64) * ROW + offset
+    staging_ptr = staging + item.to(tl.int64) * ROW + offset
+    if RESTORE:
+        data = tl.load(staging_ptr, offset < ROW, 0)
+        tl.store(device_ptr, data, offset < ROW)
+    else:
+        data = tl.load(device_ptr, offset < ROW, 0)
+        tl.store(staging_ptr, data, offset < ROW)
+
+
+class PooledPages:
+    def __init__(self, buffers, host, *, tokens_per_page, staging_pages=64):
+        assert buffers and 1 <= staging_pages <= 128
+        assert host.device.type == "cpu" and host.is_contiguous()
+        assert all(b.is_cuda and b.is_contiguous() for b in buffers)
+        assert len({b.device for b in buffers}) == 1
+        self.layers = len(buffers)
+        assert host.shape[1] == self.layers
+        self.host = host.view(torch.uint8).view(host.shape[0], self.layers, -1)
+        self.row_bytes = self.host.shape[2]
+        assert all(b.nbytes % self.row_bytes == 0 for b in buffers)
+        self.device_page_count = min(b.nbytes // self.row_bytes for b in buffers)
+        self.device = buffers[0].device
+        self.buffers = buffers
+        # Keep the original tensor because torch views do not preserve the
+        # managed-allocation owner attribute used by the HCC allocator.
+        self.host_allocation = host
+        self.ptrs = torch.tensor(
+            [b.data_ptr() for b in buffers], dtype=torch.uint64, device=self.device
+        )
+        self.staging = torch.empty(
+            (staging_pages, self.layers, self.row_bytes),
+            dtype=torch.uint8,
+            device=self.device,
+        )
+        self.capacity = staging_pages
+        self.tokens_per_page = tokens_per_page
+        self.local_pages = torch.arange(staging_pages, dtype=torch.int64)
+        self.calls = self.bytes = self.pages = 0
+
+    def _indices(self, host_indices, device_indices, restore):
+        p = self.tokens_per_page
+        assert host_indices.device.type == device_indices.device.type == "cpu"
+        assert host_indices.dtype == device_indices.dtype == torch.int64
+        assert host_indices.numel() == device_indices.numel()
+        assert host_indices.numel() % p == 0
+        result = []
+        offsets = torch.arange(p, dtype=torch.int64)
+        for indices, limit in (
+            (host_indices, self.host.shape[0]),
+            (device_indices, self.device_page_count),
+        ):
+            blocks = indices.reshape(-1, p)
+            starts = blocks[:, 0]
+            assert bool((starts % p == 0).all())
+            assert torch.equal(blocks, starts[:, None] + offsets)
+            pages = starts // p
+            if pages.numel():
+                assert int(pages.min()) >= 0 and int(pages.max()) < limit
+            result.append(pages)
+        destination = result[1 if restore else 0]
+        assert destination.unique().numel() == destination.numel(), (
+            "overlapping DMA destinations"
+        )
+        return result
+
+    def transfer(self, host_indices, device_indices, *, restore):
+        host_pages, device_pages = self._indices(host_indices, device_indices, restore)
+        if not host_pages.numel():
+            return
+        gpu_pages = device_pages.to(self.device, non_blocking=True)
+        for start in range(0, len(host_pages), self.capacity):
+            count = min(self.capacity, len(host_pages) - start)
+            local = self.local_pages[:count]
+            selected_host = host_pages[start : start + count]
+            grid = (count * self.layers, triton.cdiv(self.row_bytes, 1024))
+            if restore:
+                transfer_kv_direct(
+                    src_layers=[self.host],
+                    dst_layers=[self.staging],
+                    src_indices=selected_host,
+                    dst_indices=local,
+                    page_size=1,
+                )
+            _pages_kernel[grid](
+                self.ptrs,
+                gpu_pages[start : start + count],
+                self.staging,
+                self.row_bytes,
+                self.layers,
+                1024,
+                restore,
+            )
+            if not restore:
+                transfer_kv_direct(
+                    src_layers=[self.staging],
+                    dst_layers=[self.host],
+                    src_indices=local,
+                    dst_indices=selected_host,
+                    page_size=1,
+                )
+            # GPU access to cudaMallocManaged memory can migrate dirtied/read
+            # host pages into HBM even with a CPU preferred-location hint.
+            # Enqueue the return migration after this chunk's final consumer
+            # on the same stream, coalescing adjacent page ranges in common.py.
+            _cuda_managed_prefetch_pages_to_host(
+                self.host_allocation,
+                selected_host,
+                self.layers * self.row_bytes,
+                torch.cuda.current_stream(self.device),
+            )
+        self.calls += 1
+        self.pages += len(host_pages)
+        self.bytes += len(host_pages) * self.layers * self.row_bytes
+        self.staging.record_stream(torch.cuda.current_stream(self.device))
+        self.ptrs.record_stream(torch.cuda.current_stream(self.device))
+        gpu_pages.record_stream(torch.cuda.current_stream(self.device))
