index 0000000000..50d586af64
--- /dev/null
+++ b/python/sglang/srt/mem_cache/startup_ram_budget.py
@@ -0,0 +1,233 @@
+"""One startup RAM budget for a single-node TP hybrid HiCache replica.
+
+This downstream opt-in sizes existing fixed pools; it does not resize them at
+runtime. All ranks rendezvous after model loading and before host allocation.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import re
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from decimal import Decimal
+from pathlib import Path, PurePosixPath
+
+ENV = "SGLANG_HICACHE_RAM_BUDGET"
+RESERVE_BYTES = 10 * 1024**3
+logger = logging.getLogger(__name__)
+_active: ContextVar[RankBudget | None] = ContextVar("hicache_ram_budget", default=None)
+
+
+def parse_budget(value: str) -> tuple[str, Decimal]:
+    match = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)(%|GB|GiB)", value)
+    if match is None:
+        raise ValueError(f"{ENV} must be a percentage, GB or GiB (e.g. 80% or 256GiB)")
+    amount, unit = Decimal(match[1]), match[2]
+    if amount <= 0 or (unit == "%" and amount >= 100):
+        raise ValueError(f"{ENV} must be positive; percentages must be below 100%")
+    return unit, amount
+
+
+def _unescape_mount(value: str) -> str:
+    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), value)
+
+
+def cgroup_headrooms(proc: Path = Path("/proc")) -> list[int]:
+    """Read hard memory headroom at every visible ancestor, v2 or v1.
+
+    Resolve both namespaced and host cgroup mounts. Do not count swap or assume
+    page cache is reclaimable. Hidden ancestors cannot be inspected: the CVM's
+    MemAvailable remains an independent cap. Fail on unreadable active limits.
+    """
+    groups = {}
+    for line in (proc / "self/cgroup").read_text().splitlines():
+        _, controllers, path = line.split(":", 2)
+        if controllers == "":
+            groups["cgroup2"] = path
+        elif "memory" in controllers.split(","):
+            groups["cgroup"] = path
+    if not groups:
+        return []
+    headrooms, found = [], False
+    for line in (proc / "self/mountinfo").read_text().splitlines():
+        fields, tail = line.split(" - ", 1)
+        fields, tail = fields.split(), tail.split()
+        kind = tail[0]
+        if kind not in groups or (
+            kind == "cgroup" and "memory" not in tail[2].split(",")
+        ):
+            continue
+        root = PurePosixPath(_unescape_mount(fields[3]))
+        mount = Path(_unescape_mount(fields[4]))
+        membership = PurePosixPath(groups[kind])
+        if ".." in membership.parts:
+            raise ValueError("Cannot resolve cgroup memory path containing '..'")
+        try:
+            relative = membership.relative_to(root)
+        except ValueError:
+            continue
+        directory = mount / str(relative)
+        found = True
+        while True:
+            limit_file = "memory.max" if kind == "cgroup2" else "memory.limit_in_bytes"
+            usage_file = (
+                "memory.current" if kind == "cgroup2" else "memory.usage_in_bytes"
+            )
+            # A v2 root or ancestor without the memory controller has no files.
+            # Any existing pair must be readable and valid; never ignore errors.
+            limit_path = directory / limit_file
+            if limit_path.exists():
+                raw = limit_path.read_text().strip()
+                if raw != "max":
+                    limit = int(raw)
+                    usage = int((directory / usage_file).read_text().strip())
+                    if limit < 0 or usage < 0:
+                        raise ValueError("Negative cgroup memory counter")
+                    headrooms.append(max(0, limit - usage))
+            elif (
+                kind == "cgroup"
+                or directory == mount / str(relative)
+                and directory != mount
+            ):
+                raise ValueError(f"Missing cgroup memory controller at {directory}")
+            if directory == mount:
+                break
+            directory = directory.parent
+    if not found:
+        raise ValueError("Cannot locate the process cgroup memory mount")
+    return headrooms
+
+
+def available_ram_bytes() -> int:
+    import psutil
+
+    return max(
+        0, min(psutil.virtual_memory().available, *cgroup_headrooms(), float("inf"))
+    )
+
+
+@dataclass
+class RankBudget:
+    total_bytes: int
+    ranks: int
+    used_bytes: int = 0
+
+    @property
+    def rank_bytes(self) -> int:
+        return self.total_bytes // self.ranks
+
+    @property
+    def remaining_bytes(self) -> int:
+        return self.rank_bytes - self.used_bytes
+
+    def claim(self, requested_bytes: int) -> None:
+        if requested_bytes < 0 or requested_bytes > self.remaining_bytes:
+            raise ValueError("HiCache pools exceed the shared startup RAM budget")
+        self.used_bytes += requested_bytes
+
+
+def resolve_budget(records: list[dict]) -> RankBudget:
+    """All ranks resolve the same cap or fail together before allocating."""
+    errors = [record["error"] for record in records if record["error"]]
+    if errors:
+        raise ValueError(f"HiCache startup RAM sizing failed: {errors}")
+    configs = {record["config"] for record in records}
+    if len(configs) != 1:
+        raise ValueError(f"{ENV} differs across TP ranks")
+    unit, amount = parse_budget(configs.pop())
+    available = min(record["available_bytes"] for record in records)
+    safe = max(0, available - RESERVE_BYTES)
+    if unit == "%":
+        total = min(int(Decimal(available) * amount / 100), safe)
+    else:
+        total = int(amount * (10**9 if unit == "GB" else 1024**3))
+        if total > safe:
+            raise ValueError(f"{ENV} exceeds available RAM minus the 10 GiB reserve")
+    if total // len(records) <= 0:
+        raise ValueError("No RAM available for HiCache after the 10 GiB reserve")
+    return RankBudget(total, len(records))
+
+
+def active_budget() -> RankBudget | None:
+    return _active.get()
+
+
+def reserve_startup_bytes(requested_bytes: int) -> None:
+    if (budget := active_budget()) is not None:
+        budget.claim(requested_bytes)
+
+
+def host_page_count(tokens: int, page_size: int) -> int:
+    if active_budget() is None:
+        return tokens // page_size + 1  # Preserve upstream behavior without opt-in.
+    pages = tokens // page_size  # Never exceed the budget through page rounding.
+    if pages < 1:
+        raise ValueError("HiCache RAM budget is too small for one page/state per pool")
+    return pages
+
+
+@contextmanager
+def startup_ram_budget(*, supported: bool):
+    config = os.environ.get(ENV)
+    if config is None:
+        yield
+        return
+
+    import torch.distributed as dist
+
+    from sglang.srt.distributed.parallel_state import get_world_group
+    from sglang.srt.runtime_context import get_context, get_memory, get_parallel
+
+    world = get_world_group()
+    parallel = get_parallel()
+    # The supported deployment is one TP replica in one CVM. A world group
+    # must not mix independent DP replicas or machines with different RAM.
+    group = world.cpu_group
+    dist.barrier(group=group)
+    record = {"config": config, "available_bytes": 0, "error": None}
+    try:
+        parse_budget(config)
+        if (
+            not supported
+            or parallel.nnodes != 1
+            or world.world_size != parallel.tp_size
+        ):
+            raise ValueError(
+                "RAM budget supports a single-node TP hybrid KV+Mamba stack only"
+            )
+        if parallel.pp_size != 1 or parallel.dp_size != 1 or parallel.dcp_enabled:
+            raise ValueError("RAM budget does not support PP, DP or DCP")
+        if get_memory().hicache_size > 0:
+            raise ValueError(f"Use {ENV} OR --hicache-size, not both")
+        if get_memory().hicache_storage_backend is not None:
+            raise ValueError("RAM budget currently supports in-CVM host RAM only")
+        record["available_bytes"] = available_ram_bytes()
+    except Exception as exc:
+        record["error"] = str(exc)
+    records = [None] * world.world_size
+    dist.all_gather_object(records, record, group=group)
+    budget = resolve_budget(records)
+    get_context().override(source=ENV, hicache_size=budget.rank_bytes / 1e9)
+    logger.info(
+        "HiCache startup RAM: config=%s available_bytes=%d total_budget_bytes=%d "
+        "ranks=%d rank_budget_bytes=%d reserve_bytes=%d",
+        config,
+        min(r["available_bytes"] for r in records),
+        budget.total_bytes,
+        budget.ranks,
+        budget.rank_bytes,
+        RESERVE_BYTES,
+    )
+    token = _active.set(budget)
+    try:
+        yield budget
+        logger.info(
+            "HiCache startup RAM allocated: rank_pool_bytes=%d rank_budget_bytes=%d",
+            budget.used_bytes,
+            budget.rank_bytes,
+        )
+    finally:
+        _active.reset(token)
