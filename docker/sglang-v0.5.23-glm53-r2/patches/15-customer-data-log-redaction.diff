+def _redacted_request_exception(
+    e: requests.exceptions.RequestException,
+) -> requests.exceptions.RequestException:
+    """``e`` re-created with its message passed through `redact_text`.
+
+    requests/urllib3 put the full URL (path, query: user ids, file names,
+    pre-signed signatures) in the message: ``404 Client Error: Not Found for
+    url: https://...`` or ``... Max retries exceeded with url: /path``. The
+    status wording and the literal `` for url: `` stay, so inference-proxy's
+    client-fetch-4xx mapping (``NNN Client Error: ... for url: ...``) still
+    matches; only the URL becomes ``<url host=...>``.
+    """
+    message = redact_text(" ".join(str(a) for a in e.args) if e.args else str(e))
+    try:
+        new = type(e)(
+            message,
+            response=getattr(e, "response", None),
+            request=getattr(e, "request", None),
+        )
+    except Exception:
+        new = requests.exceptions.RequestException(
+            message, response=getattr(e, "response", None)
+        )
+    return new
+
