index 0000000000..baa0e2ad6d
--- /dev/null
+++ b/python/sglang/srt/utils/log_redaction.py
@@ -0,0 +1,178 @@
+"""Keep customer data out of log lines and error texts.
+
+Why: media URLs a client sends (pre-signed links, user ids and file names in the path or
+query), data: URIs, JSON schemas and tool-call argument values ended up verbatim in the
+engine log (logging audit, NEAR AI). The helpers here turn them into a shape that still
+helps debugging but carries no content:
+
+  * http(s)/ws(s)/ftp/file URL  -> ``<url host=example.com>``   (scheme+host kept, no
+    userinfo, port, path, query or fragment)
+  * data: URI                   -> ``<base64 len=N>``          (N = characters)
+  * raw bytes                   -> ``<bytes len=N>``
+  * any other value             -> ``<len=N sha256=0123abcd>``  (short digest, so two log
+    lines about the same value can still be matched)
+
+`redact_text` rewrites free text (exception messages, tracebacks): every URL and data: URI
+in it, urllib3's ``... with url: /path`` form, and long base64 runs.
+
+Contract kept for inference-proxy (src/proxy.rs `message_is_client_fetch_4xx`): requests'
+``NNN Client Error: <reason> for url: <url>`` keeps its status wording and the literal
+`` for url: ``; only the URL itself becomes ``<url host=...>``. The proxy matches
+``for url:`` + ``4xx client error:`` and maps such a backend 500 to 400.
+
+Stdlib only (imported by utils/common.py and the tool-call parsers).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import re
+import traceback
+from typing import Any
+from urllib.parse import urlsplit
+
+__all__ = [
+    "fingerprint",
+    "redact_url",
+    "redact_media_ref",
+    "redact_text",
+    "redacted_exception",
+    "redacted_traceback",
+    "opaque_traceback",
+]
+
+_DIGEST_CHARS = 8
+
+# A URL with a scheme we fetch or a client could send. Stops at whitespace, quotes and the
+# closing brackets that usually wrap a URL in messages ("url='...'", "(...)", "<...>").
+_URL_RE = re.compile(r"""(?i)\b(?:https?|wss?|ftp|file)://[^\s'"<>()\[\]{}`]*""")
+# data:[<mediatype>][;base64],<payload>
+_DATA_URI_RE = re.compile(r"""(?i)\bdata:[\w.+-]*/?[\w.+-]*(?:;[\w.+=-]+)*,[^\s'"<>()\[\]{}`]*""")
+# urllib3: "HTTPSConnectionPool(host='x', port=443): Max retries exceeded with url: /p?q (Caused by"
+_WITH_URL_PATH_RE = re.compile(r"(with url: )(/[^\s'\"]*)")
+# Long base64 runs (a bare base64 image, a signature). 64+ chars, and see _looks_base64:
+# a run must mix cases and digits, so source paths in a traceback are left alone.
+_B64_RUN_RE = re.compile(r"[A-Za-z0-9+/_-]{64,}={0,2}")
+
+
+def _looks_base64(run: str) -> bool:
+    upper = sum(c.isupper() for c in run)
+    lower = sum(c.islower() for c in run)
+    digits = sum(c.isdigit() for c in run)
+    return upper >= 8 and lower >= 8 and digits >= 3
+
+
+def fingerprint(value: Any) -> str:
+    """``<len=N sha256=xxxxxxxx>`` for a string/bytes (or the ``str()`` of anything else)."""
+    if isinstance(value, (bytes, bytearray, memoryview)):
+        data = bytes(value)
+    else:
+        if not isinstance(value, str):
+            try:
+                value = str(value)
+            except Exception:
+                return f"<{type(value).__name__}>"
+        data = value.encode("utf-8", "surrogatepass")
+    digest = hashlib.sha256(data).hexdigest()[:_DIGEST_CHARS]
+    return f"<len={len(value) if isinstance(value, str) else len(data)} sha256={digest}>"
+
+
+def redact_url(url: str) -> str:
+    """``<url host=example.com>`` (``<url host=?>`` when the URL has no parseable host)."""
+    try:
+        host = urlsplit(url).hostname
+    except Exception:
+        host = None
+    if not host:
+        return "<url host=?>"
+    return f"<url host={host}>"
+
+
+def _redact_data_uri(uri: str) -> str:
+    return f"<base64 len={len(uri)}>"
+
+
+def redact_media_ref(data: Any) -> str:
+    """One multimodal input item (URL, data: URI, base64 text, path, bytes, dict...) as a
+    content-free description for an error message or log line."""
+    if isinstance(data, (bytes, bytearray, memoryview)):
+        return f"<bytes len={len(data)}>"
+    if isinstance(data, str):
+        stripped = data.strip()
+        lower = stripped[:16].lower()
+        if lower.startswith("data:"):
+            return _redact_data_uri(stripped)
+        if _URL_RE.match(stripped):
+            return redact_url(stripped)
+        if (
+            len(stripped) >= 64
+            and _B64_RUN_RE.fullmatch(stripped)
+            and _looks_base64(stripped)
+        ):
+            return f"<base64 len={len(stripped)}>"
+        return fingerprint(stripped)
+    if isinstance(data, dict):
+        for key in ("url", "image_url", "video_url", "audio_url", "data"):
+            if key in data:
+                inner = data[key]
+                if isinstance(inner, dict) and "url" in inner:
+                    inner = inner["url"]
+                return f"<{type(data).__name__} {key}={redact_media_ref(inner)}>"
+        return f"<{type(data).__name__} keys={len(data)}>"
+    url = getattr(data, "url", None)
+    if isinstance(url, str):
+        return f"<{type(data).__name__} url={redact_media_ref(url)}>"
+    return f"<{type(data).__name__}>"
+
+
+def redact_text(text: Any) -> str:
+    """``text`` with every URL, data: URI, urllib3 request path and long base64 run replaced."""
+    if not isinstance(text, str):
+        try:
+            text = str(text)
+        except Exception:
+            return "<unprintable>"
+    if not text:
+        return text
+    # data: first, so its payload is not then seen as a base64 run or a URL.
+    text = _DATA_URI_RE.sub(lambda m: _redact_data_uri(m.group(0)), text)
+    text = _URL_RE.sub(lambda m: redact_url(m.group(0)), text)
+    text = _WITH_URL_PATH_RE.sub(lambda m: m.group(1) + f"<path len={len(m.group(2))}>", text)
+    text = _B64_RUN_RE.sub(
+        lambda m: (
+            f"<base64 len={len(m.group(0))}>"
+            if _looks_base64(m.group(0))
+            else m.group(0)
+        ),
+        text,
+    )
+    return text
+
+
+def redacted_exception(e: BaseException) -> str:
+    """``TypeName: <redacted message>``."""
+    return f"{type(e).__name__}: {redact_text(e)}"
+
+
+def redacted_traceback(e: BaseException) -> str:
+    """The full traceback of ``e`` (with its cause/context chain) passed through
+    `redact_text`. Use instead of ``logger.exception`` / ``exc_info=True``, which print the
+    raw exception messages."""
+    try:
+        return redact_text("".join(traceback.format_exception(type(e), e, e.__traceback__)))
+    except Exception:
+        return redacted_exception(e)
+
+
+def opaque_traceback(e: BaseException) -> str:
+    """The stack of ``e`` with its message replaced by `fingerprint` (for exceptions whose
+    message may quote model output or tool-call argument values). Only frames and the type
+    name are printed; the cause/context chain is left out."""
+    try:
+        frames = "".join(traceback.format_tb(e.__traceback__))
+    except Exception:
+        frames = ""
+    return (
+        f"Traceback (most recent call last):\n{frames}"
+        f"{type(e).__name__}: {fingerprint(e)}"
+    )
