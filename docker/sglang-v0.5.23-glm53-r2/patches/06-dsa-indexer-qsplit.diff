+# Opt-in (SGLANG_DSA_INDEXER_QSPLIT=1): split the K-pool indexer's prefill query rows across the
+# attention-TP ranks instead of computing fp8_mqa_logits + top-k for every row on every rank.
+# Each rank scores rows [r*per, (r+1)*per) against the same gathered keys and the int32 top-k
+# rows are all-gathered. Rows are independent (each carries its own key range), so the selected
+# set matches the replicated path up to top-k tie order, and the logits scratch per rank shrinks
+# by the TP size. Only used for at least SGLANG_DSA_INDEXER_QSPLIT_MIN_ROWS rows (default 1024).
+# Each rank's slice still goes through the upstream free-memory row chunking (#40854).
+_QSPLIT = get_bool_env_var("SGLANG_DSA_INDEXER_QSPLIT", "false")
+_QSPLIT_MIN_ROWS = int(os.environ.get("SGLANG_DSA_INDEXER_QSPLIT_MIN_ROWS", "1024"))
+
+
+def _qsplit_group(n_rows: int):
+    """The attention-TP group to split over, or None. Identical on every rank (n_rows is shared)."""
+    if not _QSPLIT or n_rows < _QSPLIT_MIN_ROWS:
+        return None
+    from sglang.srt.distributed import get_attn_tp_group
+
+    group = get_attn_tp_group()
+    return group if group.world_size > 1 else None
+
