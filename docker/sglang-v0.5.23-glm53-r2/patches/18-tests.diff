diff --git a/test/manual/test_pooled_pages_gpu.py b/test/manual/test_pooled_pages_gpu.py
new file mode 100644
index 0000000000..4468cb880c
--- /dev/null
+++ b/test/manual/test_pooled_pages_gpu.py
@@ -0,0 +1,158 @@
+"""Synthetic exact-byte PooledPages checks on every rank, plus a NCCL collective.
+
+torchrun --nnodes=1 --nproc-per-node=<gpus> --master-addr=127.0.0.1 \
+  --master-port=29500 test/manual/test_pooled_pages_gpu.py
+
+(v0.5.23 port: the fork's packed-MTP / mixed-draft L2-engine cases built
+pools with the fork constructors and are not carried. Also checks the
+PooledL2 eligibility and full-coverage plan against a stand-in MLA host.)
+"""
+
+import os
+import json
+import torch
+import torch.distributed as dist
+from types import SimpleNamespace
+
+from sglang.srt.mem_cache.l2_transfer import L2Transfer
+from sglang.srt.mem_cache.pool_host.mla import MLATokenToKVPoolHost
+from sglang.srt.mem_cache.pooled_l2 import PooledL2
+from sglang.srt.mem_cache.pooled_pages import PooledPages
+
+
+def check_pages(rank):
+    gen = torch.Generator().manual_seed(5353 + rank)
+    # More than one staging chunk, shuffled sparse addresses, raw BF16 and
+    # packed index rows. Target+MTP are carried as twelve attention layers.
+    for layers, row, dtype in [
+        (12, 64 * 512 * 2, torch.bfloat16),
+        (7, 64 * 132, torch.uint8),
+    ]:
+        dev = [
+            torch.empty((96, row // dtype.itemsize), dtype=dtype, device="cuda")
+            for _ in range(layers)
+        ]
+        original = [
+            torch.randint(0, 256, (96, row), dtype=torch.uint8, generator=gen)
+            for _ in dev
+        ]
+        for d, o in zip(dev, original):
+            d.view(torch.uint8).copy_(o)
+        host = torch.empty((192, layers, 1, row), dtype=torch.uint8, pin_memory=True)
+        down = PooledPages(dev, host, tokens_per_page=64, staging_pages=7)
+        up = PooledPages(dev, host, tokens_per_page=64, staging_pages=7)
+        src = torch.randperm(96, generator=gen)[:73]
+        hp = torch.randperm(192, generator=gen)[:73]
+        dst = torch.randperm(96, generator=gen)[:73]
+        tokens = lambda p: (p[:, None] * 64 + torch.arange(64)).flatten()
+        ds, hs = torch.cuda.Stream(), torch.cuda.Stream()
+        ds.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(ds):
+            down.transfer(tokens(hp[:31]), tokens(src[:31]), restore=False)
+            down.transfer(tokens(hp[31:]), tokens(src[31:]), restore=False)
+            done = ds.record_event()
+        torch.cuda.current_stream().wait_event(done)
+        for d in dev:
+            d.view(torch.uint8).fill_(173)
+        hs.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(hs):
+            up.transfer(tokens(hp), tokens(dst), restore=True)
+            done = hs.record_event()
+        done.synchronize()
+        for layer, (d, o) in enumerate(zip(dev, original)):
+            assert torch.equal(d.view(torch.uint8).cpu()[dst], o[src]), (
+                rank,
+                layer,
+                row,
+            )
+            assert torch.equal(host[:, layer, 0][hp], o[src]), (
+                "host",
+                rank,
+                layer,
+                row,
+            )
+        print(
+            json.dumps(
+                {
+                    "rank": rank,
+                    "kind": "pooled_pages",
+                    "layers": layers,
+                    "bytes_each_direction": layers * 73 * row,
+                    "passed": True,
+                }
+            ),
+            flush=True,
+        )
+    check_pooled_l2(rank)
+
+
+def fake_mla_host(layers, target_layers, page_size=64, pages=32, dim=656):
+    """Stand-in with the v0.5.23 MLA host attributes PooledL2 reads."""
+    host = object.__new__(MLATokenToKVPoolHost)
+    host._is_dummy = False
+    host.layout = "page_first_direct"
+    host.dcp_size = 1
+    host._layer_shard_enabled = False
+    host._native_buffers = None
+    host._strided_device_row_bytes = None
+    host.page_size = page_size
+    host.kv_cache_dim = dim
+    host.dtype = torch.uint8
+    host.layer_num = layers
+    host.device_kv_buffers = tuple(
+        torch.randint(0, 256, (pages * page_size, 1, dim), dtype=torch.uint8, device="cuda")
+        for _ in range(layers)
+    )
+    host.kv_buffer = torch.zeros(
+        (pages, layers, page_size, 1, dim), dtype=torch.uint8, pin_memory=True
+    )
+    host._target_layer_indices = tuple(range(target_layers))
+    host._host_layer_by_controller = {i: i for i in range(target_layers)}
+    host._host_layer_by_controller.update(
+        {100 + d: target_layers + d for d in range(layers - target_layers)}
+    )
+    return host
+
+
+def check_pooled_l2(rank):
+    target_layers, drafts = 6, 2
+    host = fake_mla_host(target_layers + drafts, target_layers)
+    originals = [b.clone() for b in host.device_kv_buffers]
+    tokens = lambda p: (p[:, None] * 64 + torch.arange(64)).flatten()
+    hp, dp = torch.tensor([3, 1, 9]), torch.tensor([4, 0, 7])
+    io = PooledL2("direct")
+    target = L2Transfer(host, None, tokens(hp), tokens(dp), lambda n: n if n < target_layers else None)
+    assert io.backup(target)
+    torch.cuda.synchronize()
+    for b in host.device_kv_buffers:
+        b.zero_()
+    # Target-only coverage is incomplete: must fall back to per-layer loads.
+    assert io.prepare_restore([target], target_layers) == set()
+    draft_transfers = [
+        L2Transfer(
+            host, None, target.host_indices, target.device_indices,
+            (lambda n, d=d: 100 + d if n == d else None), True,
+        )
+        for d in range(drafts)
+    ]
+    assert io.prepare_restore([target, *draft_transfers], target_layers) == {0, 1, 2}
+    torch.cuda.synchronize()
+    rows = tokens(dp)
+    for layer, (b, o) in enumerate(zip(host.device_kv_buffers, originals)):
+        assert torch.equal(b[rows], o[rows]), (rank, layer)
+    # Ineligible layouts keep the upstream path.
+    host.layout = "page_first"
+    assert not io.backup(target)
+    print(json.dumps({"rank": rank, "kind": "pooled_l2_plan", "passed": True}), flush=True)
+
+if __name__ == "__main__":
+    rank = int(os.environ["LOCAL_RANK"])
+    torch.cuda.set_device(rank)
+    dist.init_process_group("nccl")
+    with torch.inference_mode():
+        check_pages(rank)
+    count = torch.tensor(1, device="cuda")
+    dist.all_reduce(count)
+    assert count.item() == dist.get_world_size()
+    print(json.dumps({"rank": rank, "all_four_ranks_passed": True}), flush=True)
+    dist.destroy_process_group()
diff --git a/test/manual/test_startup_ram_budget_tp.py b/test/manual/test_startup_ram_budget_tp.py
new file mode 100644
index 0000000000..4f00385d3c
--- /dev/null
+++ b/test/manual/test_startup_ram_budget_tp.py
@@ -0,0 +1,83 @@
+"""Real Gloo rendezvous and cgroup sampling; no GPUs or large allocations.
+
+torchrun --nnodes=1 --nproc-per-node=4 --master-addr=127.0.0.1 \
+  --master-port=29500 test/manual/test_startup_ram_budget_tp.py
+"""
+
+import os
+from contextlib import ExitStack
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import torch.distributed as dist
+
+from sglang.srt.mem_cache import startup_ram_budget as ram
+
+dist.init_process_group("gloo")
+rank, size = dist.get_rank(), dist.get_world_size()
+try:
+    with ExitStack() as stack:
+        # No allocation occurs here. Small CI guests cannot leave the production
+        # 10 GiB reserve; unit tests separately enforce that policy.
+        stack.enter_context(patch.object(ram, "RESERVE_BYTES", 0))
+        stack.enter_context(
+            patch(
+                "sglang.srt.distributed.parallel_state.get_world_group",
+                return_value=SimpleNamespace(
+                    cpu_group=dist.group.WORLD, world_size=size
+                ),
+            )
+        )
+        stack.enter_context(
+            patch(
+                "sglang.srt.runtime_context.get_parallel",
+                return_value=SimpleNamespace(
+                    nnodes=1, tp_size=size, pp_size=1, dp_size=1, dcp_enabled=False
+                ),
+            )
+        )
+        memory = SimpleNamespace(hicache_size=0, hicache_storage_backend=None)
+        stack.enter_context(
+            patch("sglang.srt.runtime_context.get_memory", return_value=memory)
+        )
+        context = MagicMock()
+        stack.enter_context(
+            patch("sglang.srt.runtime_context.get_context", return_value=context)
+        )
+        os.environ[ram.ENV] = "80%"
+        with ram.startup_ram_budget(supported=True) as budget:
+            totals = [None] * size
+            dist.all_gather_object(totals, budget.total_bytes)
+            assert len(set(totals)) == 1
+            assert budget.rank_bytes * size <= budget.total_bytes
+            context.override.assert_called_once_with(
+                source=ram.ENV, hicache_size=budget.rank_bytes / 1e9
+            )
+            ram.reserve_startup_bytes(budget.rank_bytes)
+            try:
+                ram.reserve_startup_bytes(1)
+            except ValueError:
+                pass
+            else:
+                raise AssertionError("Rank exceeded the shared budget")
+        assert ram.active_budget() is None
+        # One bad rank fails every rank BEFORE any pool construction.
+        os.environ[ram.ENV] = "bad" if rank == 0 else "80%"
+        try:
+            with ram.startup_ram_budget(supported=True):
+                raise AssertionError("Bad peer configuration was ignored")
+        except ValueError as exc:
+            assert "startup RAM sizing failed" in str(exc)
+        os.environ[ram.ENV] = "80%"
+        memory.hicache_size = 64 if rank == 0 else 0
+        try:
+            with ram.startup_ram_budget(supported=True):
+                raise AssertionError("Conflicting CLI size was ignored")
+        except ValueError as exc:
+            assert "--hicache-size" in str(exc)
+        print(
+            f"rank={rank} shared_budget_bytes={totals[0]} real_cgroup_and_peer_failure_checks=passed",
+            flush=True,
+        )
+finally:
+    dist.destroy_process_group()
diff --git a/test/registered/unit/mem_cache/test_hicache_draft_plan.py b/test/registered/unit/mem_cache/test_hicache_draft_plan.py
new file mode 100644
index 0000000000..f5bab90745
--- /dev/null
+++ b/test/registered/unit/mem_cache/test_hicache_draft_plan.py
@@ -0,0 +1,187 @@
+"""HiCache must select separate host rows before allocating incompatible MTP KV."""
+
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+
+from sglang.srt.mem_cache.memory_pool import (
+    HybridLinearKVPool,
+    MLATokenToKVPool,
+    MLATokenToKVPoolFP4,
+)
+from sglang.srt.speculative.base_spec_worker import BaseSpecWorker, HiCacheDraftMode
+from sglang.srt.speculative.spec_info import SpeculativeAlgorithm
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=1, suite="base-a-test-cpu")
+
+
+def mla_pool(dtype=torch.uint8, dim=656, *, hybrid=False):
+    pool = object.__new__(MLATokenToKVPool)
+    pool.store_dtype = dtype
+    pool.kv_cache_dim = dim
+    if hybrid:
+        wrapper = object.__new__(HybridLinearKVPool)
+        wrapper.full_kv_pool = pool
+        return wrapper
+    return pool
+
+
+def build_plan(
+    target_pool,
+    draft_pools,
+    *,
+    algorithm=SpeculativeAlgorithm.EAGLE,
+    nextn=1,
+    enabled=True,
+    backup="none",
+    architecture="Glm5NextForCausalLMMTP",
+):
+    target = SimpleNamespace(
+        token_to_kv_pool=target_pool,
+        spec_algorithm=algorithm,
+        mtp_draft_device_pools=("stale",),
+        req_to_token_pool=SimpleNamespace(),
+    )
+    runners = tuple(
+        SimpleNamespace(
+            token_to_kv_pool=pool,
+            req_to_token_pool=SimpleNamespace(),
+            model_config=SimpleNamespace(
+                num_nextn_predict_layers=nextn,
+                hf_config=SimpleNamespace(architectures=[architecture]),
+            ),
+        )
+        for pool in draft_pools
+    )
+    worker = SimpleNamespace(
+        target_worker=SimpleNamespace(model_runner=target),
+        _draft_model_runners=lambda: runners,
+    )
+    prefix = "sglang.srt.speculative.base_spec_worker."
+    with (
+        patch(
+            prefix + "get_memory",
+            return_value=SimpleNamespace(
+                enable_hierarchical_cache=enabled,
+                enable_unified_cache_external_linker=False,
+            ),
+        ),
+        patch(
+            prefix + "get_disagg",
+            return_value=SimpleNamespace(
+                disaggregation_decode_retraction_backup=backup
+            ),
+        ),
+    ):
+        plan = BaseSpecWorker._build_hicache_draft_plan(worker)
+    return plan, target
+
+
+class TestHiCacheDraftPlan(unittest.TestCase):
+    def test_fp4_target_or_draft_is_rejected_before_selecting_a_plan(self):
+        fp4 = object.__new__(MLATokenToKVPoolFP4)
+        fp4.store_dtype = torch.uint8
+        fp4.kv_cache_dim = 656
+        for target, draft in (
+            (fp4, mla_pool(torch.bfloat16, 576)),
+            (mla_pool(torch.bfloat16, 576), fp4),
+            (fp4, mla_pool()),
+            (mla_pool(), fp4),
+        ):
+            for hybrid in (False, True):
+                with self.subTest(
+                    target_fp4=target is fp4,
+                    hybrid=hybrid,
+                    draft_dtype=draft.store_dtype,
+                ):
+                    if hybrid:
+                        wrapper = object.__new__(HybridLinearKVPool)
+                        wrapper.full_kv_pool = target
+                        target_pool = wrapper
+                    else:
+                        target_pool = target
+                    with self.assertRaisesRegex(NotImplementedError, "FP4 MLA KV"):
+                        build_plan(target_pool, (draft,))
+
+    def test_mismatched_mla_uses_sidecar(self):
+        for target_hybrid in (False, True):
+            for draft_hybrid in (False, True):
+                for dtype, dim in (
+                    (torch.uint8, 528),
+                    (torch.bfloat16, 656),
+                    (torch.bfloat16, 576),
+                    (torch.bfloat16, 328),
+                ):
+                    with self.subTest(
+                        target_hybrid=target_hybrid,
+                        draft_hybrid=draft_hybrid,
+                        dtype=dtype,
+                        dim=dim,
+                    ):
+                        draft = mla_pool(dtype, dim, hybrid=draft_hybrid)
+                        plan, target = build_plan(
+                            mla_pool(hybrid=target_hybrid), (draft,)
+                        )
+                        self.assertEqual(plan.mode, HiCacheDraftMode.SIDECAR)
+                        self.assertEqual(plan.device_pools, (draft,))
+                        self.assertEqual(target.mtp_draft_device_pools, ())
+
+    def test_matching_mla_keeps_all_packed_depths(self):
+        for hybrid in (False, True):
+            for count in (1, 3):
+                with self.subTest(hybrid=hybrid, count=count):
+                    drafts = tuple(mla_pool(hybrid=hybrid) for _ in range(count))
+                    plan, target = build_plan(mla_pool(hybrid=hybrid), drafts)
+                    self.assertEqual(plan.mode, HiCacheDraftMode.PACKED)
+                    self.assertEqual(plan.device_pools, drafts)
+                    self.assertEqual(target.mtp_draft_device_pools, drafts)
+
+    def test_later_mtp_depth_cannot_be_silently_dropped(self):
+        drafts = (mla_pool(), mla_pool(torch.bfloat16, 576))
+        with self.assertRaisesRegex(
+            NotImplementedError, "sidecar fallback supports one"
+        ):
+            build_plan(mla_pool(), drafts)
+
+    def test_disabled_cache_and_no_draft_clear_packed_state(self):
+        for drafts, enabled in (((mla_pool(),), False), ((), True)):
+            with self.subTest(enabled=enabled):
+                plan, target = build_plan(mla_pool(), drafts, enabled=enabled)
+                self.assertEqual(plan.mode, HiCacheDraftMode.NONE)
+                self.assertEqual(target.mtp_draft_device_pools, ())
+
+    def test_host_retraction_backup_also_uses_fallback(self):
+        plan, target = build_plan(
+            mla_pool(),
+            (mla_pool(torch.bfloat16, 576),),
+            enabled=False,
+            backup="host_pool",
+        )
+        self.assertEqual(plan.mode, HiCacheDraftMode.SIDECAR)
+        self.assertEqual(target.mtp_draft_device_pools, ())
+
+    def test_non_mtp_eagle_keeps_legacy_sidecar(self):
+        drafts = (mla_pool(), mla_pool())
+        plan, target = build_plan(mla_pool(), drafts, nextn=0)
+        self.assertEqual(plan.mode, HiCacheDraftMode.SIDECAR)
+        self.assertEqual(plan.device_pools, drafts[:1])
+        self.assertEqual(target.mtp_draft_device_pools, ())
+
+    def test_non_mla_dspark_packing_is_unchanged(self):
+        drafts = (object(),)
+        plan, target = build_plan(
+            object(),
+            drafts,
+            algorithm=SpeculativeAlgorithm.DSPARK,
+            nextn=0,
+            architecture="DeepseekV4ForCausalLMDSpark",
+        )
+        self.assertEqual(plan.mode, HiCacheDraftMode.PACKED)
+        self.assertEqual(target.mtp_draft_device_pools, drafts)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/test/registered/unit/mem_cache/test_startup_ram_budget.py b/test/registered/unit/mem_cache/test_startup_ram_budget.py
new file mode 100644
index 0000000000..50645a7beb
--- /dev/null
+++ b/test/registered/unit/mem_cache/test_startup_ram_budget.py
@@ -0,0 +1,197 @@
+"""Synthetic startup sizing: no GPUs, model files or large allocations needed."""
+
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from sglang.srt.mem_cache import startup_ram_budget as ram
+
+GiB = 1024**3
+
+
+def records(config="80%", available=100 * GiB, ranks=4):
+    return [
+        dict(config=config, available_bytes=available, error=None) for _ in range(ranks)
+    ]
+
+
+class StartupBudgetTest(unittest.TestCase):
+    def test_fraction_is_shared_across_ranks(self):
+        for ranks in (1, 2, 4, 8):
+            budget = ram.resolve_budget(records(ranks=ranks))
+            self.assertEqual(budget.total_bytes, 80 * GiB)
+            self.assertEqual(budget.rank_bytes, 80 * GiB // ranks)
+
+    def test_explicit_units_and_least_available_rank(self):
+        self.assertEqual(ram.resolve_budget(records("64GB")).total_bytes, 64 * 10**9)
+        self.assertEqual(ram.resolve_budget(records("64GiB")).total_bytes, 64 * GiB)
+        peers = records()
+        peers[2]["available_bytes"] = 80 * GiB
+        self.assertEqual(ram.resolve_budget(peers).total_bytes, 64 * GiB)
+
+    def test_low_ram_reserve_and_oversized_fixed_budget(self):
+        self.assertEqual(
+            ram.resolve_budget(records(available=20 * GiB)).total_bytes, 10 * GiB
+        )
+        for config, available in (
+            ("95GiB", 100 * GiB),
+            ("80%", 10 * GiB),
+            ("0.000000001GB", 20 * GiB),
+        ):
+            with self.subTest(config=config), self.assertRaises(ValueError):
+                ram.resolve_budget(records(config, available))
+
+    def test_invalid_config_and_peer_errors(self):
+        for value in (
+            "",
+            "0",
+            "-1GiB",
+            "100%",
+            "0%",
+            "80",
+            "NaN%",
+            "infGB",
+            "8TB",
+            " 80%",
+            "80%\n",
+        ):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                ram.parse_budget(value)
+        peers = records()
+        peers[1]["config"] = "70%"
+        with self.assertRaisesRegex(ValueError, "differs"):
+            ram.resolve_budget(peers)
+        peers[1]["error"] = "unreadable cgroup"
+        with self.assertRaisesRegex(ValueError, "unreadable cgroup"):
+            ram.resolve_budget(peers)
+
+    def test_cumulative_claims_and_page_rounding(self):
+        budget = ram.RankBudget(4000, 4)
+        token = ram._active.set(budget)
+        self.addCleanup(ram._active.reset, token)
+        self.assertEqual(ram.host_page_count(256, 64), 4)
+        self.assertEqual(ram.host_page_count(255, 64), 3)
+        with self.assertRaises(ValueError):
+            ram.host_page_count(63, 64)
+        # KV, recurrent state and index all spend the SAME rank allowance.
+        for size in (600, 300, 100):
+            ram.reserve_startup_bytes(size)
+        self.assertEqual(budget.remaining_bytes, 0)
+        with self.assertRaises(ValueError):
+            ram.reserve_startup_bytes(1)
+
+    def test_host_pool_budget_check_books_against_rank_budget(self):
+        # v0.5.23 port: every host pool books through host_memory_budget_bytes.
+        from sglang.srt.mem_cache.pool_host import base
+
+        budget = ram.RankBudget(4000, 4)
+        token = ram._active.set(budget)
+        self.addCleanup(ram._active.reset, token)
+        self.assertEqual(base.host_memory_budget_bytes(600), 1000)
+        self.assertEqual(budget.remaining_bytes, 400)
+        # A request that does not fit is reported, not booked; the pool raises.
+        self.assertEqual(base.host_memory_budget_bytes(500), 400)
+        self.assertEqual(budget.remaining_bytes, 400)
+        self.assertEqual(base.host_memory_budget_bytes(400), 400)
+        self.assertEqual(budget.remaining_bytes, 0)
+
+    def test_disabled_leaves_upstream_sizing_unchanged(self):
+        with patch.dict("os.environ", {}, clear=True):
+            with ram.startup_ram_budget(supported=False):
+                self.assertIsNone(ram.active_budget())
+                self.assertEqual(ram.host_page_count(256, 64), 5)
+                ram.reserve_startup_bytes(10**15)
+
+
+class CgroupTest(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.root = Path(temp.name)
+        self.proc = self.root / "proc"
+        (self.proc / "self").mkdir(parents=True)
+        self.mount = self.root / "cgroup"
+        self.mount.mkdir()
+
+    def mountinfo(self, *, kind="cgroup2", membership="/job/rank", root="/"):
+        controllers = "" if kind == "cgroup2" else "memory"
+        (self.proc / "self/cgroup").write_text(f"0:{controllers}:{membership}\n")
+        opts = "rw" if kind == "cgroup2" else "rw,memory"
+        (self.proc / "self/mountinfo").write_text(
+            f"1 2 0:1 {root} {self.mount} rw - {kind} cgroup {opts}\n"
+        )
+
+    def limit(self, path, limit, used, *, kind="cgroup2"):
+        directory = self.mount / path
+        directory.mkdir(parents=True, exist_ok=True)
+        limit_file, usage_file = (
+            ("memory.max", "memory.current")
+            if kind == "cgroup2"
+            else ("memory.limit_in_bytes", "memory.usage_in_bytes")
+        )
+        (directory / limit_file).write_text(str(limit))
+        (directory / usage_file).write_text(str(used))
+
+    def test_v2_parent_limit_tighter_than_container(self):
+        self.mountinfo()
+        self.limit("job/rank", 1000, 100)
+        self.limit("job", 2000, 1500)
+        self.limit("", "max", 2000)
+        self.assertEqual(ram.cgroup_headrooms(self.proc), [900, 500])
