+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Patch 26: class- and cache-aware engine-core admission (HTTP 429 shedding).
+
+Called from ``EngineCoreProc._handle_client_request`` (ADD), after the paused
+check and before ``add_request``. It measures work in UNCACHED prompt tokens
+(the prefix-cache hit is subtracted with a side-effect-free probe), per engine
+rank, and needs no collective.
+
+Classes (by uncached tokens of the new request, ``VLLM_ADMIT_LONG_CUTOFF_TOKENS``):
+  short: reject when other shorts are queued and
+         queued_short_uncached + own > VLLM_ADMIT_SHORT_MAX_TOKENS.
+         A lone short always fits (nothing queued -> admit).
+  long:  reject (overloaded_long_count) when in-flight longs >=
+         VLLM_ADMIT_LONG_MAX_INFLIGHT, or (overloaded_long_yield) when the
+         short backlog (uncached tokens of shorts only, never longs) exceeds
+         VLLM_ADMIT_LONG_YIELD_SHORT_TOKENS (0 = off). Cold large prefills are
+         shed first; shorts keep being accepted up to their own hard limit.
+
+Class is ALWAYS by uncached tokens (prompt minus prefix-cache hit), never by
+full prompt length: a warm 172k conversation with a small tail is short. This
+holds for the new request, waiting requests (re-probed), and preempted ones.
+
+All counts are recomputed from ``scheduler.requests`` on every ADD, so there
+is no counter to leak: finish, abort, client disconnect and KV-transfer failure
+all drop the request from that dict. Requests that are finished but still wait
+for a P/D lease are skipped via ``is_finished()``.
+
+Long-class state (``req.p26_long``) is set at admission, refreshed for requests
+that have not started (cache re-probed at each decision), cleared when prefill
+completes, and re-derived after preemption. Abort/finish drop the request from
+``scheduler.requests``, so they leave the count. Standalone: no patch-25 state.
+
+Role gate: runs only on a prefill engine (``resolve_role``: kv_role=kv_producer
+or VLLM_ADMIT_ROLE=prefill). Per request, ``do_remote_prefill`` is never shed.
+Units: every knob is per engine core = per prefill DP rank, not per P/D pair.
+Every knob is 0/unset = off, and the whole module is then inert.
+"""
+
+import os
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+REASON_SHORT = "overloaded_short"
+REASON_LONG = "overloaded_long_count"
+REASON_LONG_YIELD = "overloaded_long_yield"
+REASONS = (REASON_SHORT, REASON_LONG, REASON_LONG_YIELD)
+
+DEFAULT_LONG_CUTOFF_TOKENS = 65536
+
+
+def _env_int(name: str, default: int = 0) -> int:
+    raw = os.environ.get(name)
+    if raw is None or not raw.strip():
+        return default
+    try:
+        return max(0, int(raw))
+    except ValueError:
+        logger.warning("Ignoring non-integer %s=%r (using %d)", name, raw, default)
+        return default
+
+
+def _is_decode_side(req) -> bool:
+    kvp = getattr(req, "kv_transfer_params", None)
+    return bool(kvp) and bool(kvp.get("do_remote_prefill"))
+
+
+def _not_started(req) -> bool:
+    """Nothing computed on this rank (never started, or preempted and reset)."""
+    return req.num_computed_tokens == 0
+
+
+def _remaining_uncached(req) -> int:
+    """Prompt tokens this request still has to compute on this rank.
+
+    For a request with nothing computed, this is the uncached estimate;
+    ``AdmissionP26.backlog`` refreshes it from the cache before use.
+    """
+    if _not_started(req):
+        est = getattr(req, "p26_uncached", None)
+        if est is not None:
+            return est
+    return max(0, req.num_prompt_tokens - req.num_computed_tokens)
+
+
+def resolve_role(scheduler) -> str:
+    """'prefill' or 'off'. Explicit: shedding runs only on a prefill engine.
+
+    VLLM_ADMIT_ROLE=prefill|off overrides. Otherwise kv_role=kv_producer is a
+    prefill engine; kv_consumer is off; kv_both / no connector is ambiguous
+    (could be the decode half or a mixed engine) and stays off until the
+    operator sets VLLM_ADMIT_ROLE=prefill.
+    """
+    forced = os.environ.get("VLLM_ADMIT_ROLE", "").strip().lower()
+    if forced in ("prefill", "off"):
+        return forced
+    kv_cfg = getattr(getattr(scheduler, "vllm_config", None), "kv_transfer_config", None)
+    return "prefill" if getattr(kv_cfg, "kv_role", None) == "kv_producer" else "off"
+
+
+class AdmissionP26:
+    def __init__(
+        self,
+        short_max_tokens: int = 0,
+        long_max_inflight: int = 0,
+        cutoff: int = DEFAULT_LONG_CUTOFF_TOKENS,
+        long_yield_short_tokens: int = 0,
+    ) -> None:
+        self.long_yield_short_tokens = long_yield_short_tokens
+        self.short_max_tokens = short_max_tokens
+        self.long_max_inflight = long_max_inflight
+        self.cutoff = cutoff
+        self.rejected: dict[str, int] = {r: 0 for r in REASONS}
+
+    @classmethod
+    def from_env(cls, scheduler=None) -> "AdmissionP26":
+        ctl = cls(
+            short_max_tokens=_env_int("VLLM_ADMIT_SHORT_MAX_TOKENS"),
+            long_max_inflight=_env_int("VLLM_ADMIT_LONG_MAX_INFLIGHT"),
+            cutoff=_env_int(
+                "VLLM_ADMIT_LONG_CUTOFF_TOKENS", DEFAULT_LONG_CUTOFF_TOKENS
+            ),
+            long_yield_short_tokens=_env_int("VLLM_ADMIT_LONG_YIELD_SHORT_TOKENS"),
+        )
+        if ctl.enabled and scheduler is not None and resolve_role(scheduler) != "prefill":
+            logger.warning(
+                "VLLM_ADMIT_* is set but this engine is not identified as a "
+                "prefill engine (kv_role=kv_producer or VLLM_ADMIT_ROLE=prefill); "
+                "admission shedding is disabled."
+            )
+            ctl.short_max_tokens = ctl.long_max_inflight = 0
+            ctl.long_yield_short_tokens = 0
+        if ctl.enabled:
+            logger.info(
+                "Patch 26 admission: short_max_tokens=%d long_max_inflight=%d "
+                "long_yield_short_tokens=%d cutoff=%d",
+                ctl.short_max_tokens,
+                ctl.long_max_inflight,
+                ctl.long_yield_short_tokens,
+                ctl.cutoff,
+            )
+        return ctl
+
+    @property
+    def enabled(self) -> bool:
+        return (
+            self.short_max_tokens > 0
+            or self.long_max_inflight > 0
+            or self.long_yield_short_tokens > 0
+        )
+
+    def _exempt(self, sched, req) -> bool:
+        return (
+            _is_decode_side(req)
+            or req.abort_immediately
+            or req.resumable
+            or req.sampling_params is None
+            or sched.has_request(req.request_id)
+        )
+
+    def backlog(self, sched) -> tuple[int, int]:
+        """(uncached tokens queued in short requests, number of in-flight longs).
+
+        In flight = admitted to the scheduler (any queue) and not yet done with
+        prefill on this rank.
+        """
+        short_q = longs = 0
+        for r in sched.requests.values():
+            if r.is_finished() or _is_decode_side(r):
+                continue
+            if _not_started(r):
+                # Cache may have grown (or shrunk) since admission: re-probe at
+                # the decision point and re-class (nothing computed yet).
+                try:
+                    hit = sched.kv_cache_manager.get_num_cached_tokens(r)
+                    r.p26_uncached = max(0, r.num_prompt_tokens - hit)
+                    r.p26_long = r.p26_uncached > self.cutoff
+                except Exception:
+                    pass  # keep the admission-time estimate
+            rem = _remaining_uncached(r)
+            if rem <= 0:
+                # Prefill done: clear the long mark (a later preemption re-derives it).
+                r.p26_long = None
+                continue
+            is_long = getattr(r, "p26_long", None)
+            if is_long is None:
+                is_long = rem > self.cutoff
+                r.p26_long = is_long
+            if is_long:
+                longs += 1
+            else:
+                short_q += rem
+        return short_q, longs
+
+    def verdict(self, sched, req) -> str | None:
+        """None to admit, else the rejection reason. Never mutates the cache."""
+        if not self.enabled or self._exempt(sched, req):
+            return None
+        try:
+            hit = sched.kv_cache_manager.get_num_cached_tokens(req)
+        except Exception:
+            logger.exception("Patch 26 cache probe failed; admitting request")
+            return None
+        own = max(0, req.num_prompt_tokens - hit)
+        is_long = own > self.cutoff
+        short_q, longs = self.backlog(sched)
+        reason = None
+        if is_long:
+            if self.long_max_inflight > 0 and longs >= self.long_max_inflight:
+                reason = REASON_LONG
+            elif (
+                self.long_yield_short_tokens > 0
+                and short_q > self.long_yield_short_tokens
+            ):
+                reason = REASON_LONG_YIELD
+        elif (
+            self.short_max_tokens > 0
+            and short_q > 0
+            and short_q + own > self.short_max_tokens
+        ):
+            reason = REASON_SHORT
+        if reason is not None:
+            self.rejected[reason] += 1
+            return reason
+        # Sticky class and uncached estimate, used by later backlog() scans.
+        req.p26_long = is_long
+        req.p26_uncached = own
+        return None
