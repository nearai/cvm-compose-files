+def admit_retry_after(reason: str) -> int:
+    """Retry-After seconds for an admission rejection (patch 26)."""
+    import os
+
+    is_long = reason.startswith("overloaded_long")  # count and yield
+    name = (
+        "VLLM_ADMIT_RETRY_AFTER_LONG_S"
+        if is_long
+        else "VLLM_ADMIT_RETRY_AFTER_SHORT_S"
+    )
+    default = 10 if is_long else 1
+    try:
+        return max(1, int(os.environ.get(name, default)))
+    except ValueError:
+        return default
+
+
+class EngineOverloadedError(GracefulHTTPError):
+    """Engine-core class-aware admission rejection (patch 26).
+
+    HTTP 429 with a Retry-After header. ``reason`` is the
+    ``vllm:admission_rejections`` label (overloaded_short / overloaded_long).
+    """
+
+    def __init__(self, reason: str):
+        super().__init__(
+            "The engine has reached its prefill token backlog limit "
+            f"for this request class ({reason}). Please try again "
+            "later or on a different instance.",
+            HTTPStatus.TOO_MANY_REQUESTS,
+        )
+        self.reason = reason
+        self.retry_after = admit_retry_after(reason)
+
+
