+    def _input_ids_array(self, input_ids, check_vocab: bool = True) -> array:
+        # Token ids index the embedding table. min/max over a zero-copy numpy view
+        # of the int64 array keeps the check cheap for long prompts.
+        try:
+            ids = array("q", input_ids)
+        except (TypeError, OverflowError):
+            raise ValueError(
+                "input_ids must be a flat list of 64-bit integers."
+            ) from None
+        if check_vocab and ids:
+            vocab_size = self.model_config.vocab_size
+            view = np.frombuffer(ids, dtype=np.int64)
+            if view.min() < 0 or view.max() >= vocab_size:
+                raise ValueError(
+                    "input_ids contains an out-of-vocabulary token id; "
+                    f"valid range is [0, {vocab_size})."
+                )
+        return ids
+
