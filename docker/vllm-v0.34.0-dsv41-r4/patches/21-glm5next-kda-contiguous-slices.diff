+# VLLM_NEAR_KDA_SLICE=1 (read once at import) uses slices instead of index_select and
+# index_copy_ in the mixed spec / non-spec path when the token groups are two contiguous
+# ranges. Off by default.
+# VLLM_NEAR_KDA_SLICE_VERIFY=1 (debug) compares the slice plan against the index tensors
+# once per step; this adds one GPU->CPU sync.
+_KDA_SLICE = os.environ.get("VLLM_NEAR_KDA_SLICE", "0") == "1"
+_KDA_SLICE_VERIFY = os.environ.get("VLLM_NEAR_KDA_SLICE_VERIFY", "0") == "1"
+_SLICE_PLAN_ATTR = "_kda_slice_plan"
+
+
+def _kda_slice_plan(md: GDNAttentionMetadata):
+    """Return ``((spec_start, spec_len), (ns_start, ns_len))`` when the spec and
+    non-spec token groups are two adjacent contiguous ranges, else ``None``.
+
+    Computed from host-side metadata only (``spec_sequence_masks_cpu`` and the
+    Python ints ``num_spec_decode_tokens`` / ``num_prefill_tokens`` /
+    ``num_decode_tokens``), so there is no GPU->CPU sync. The result is cached
+    on the metadata object, which all KDA layers of a step share, so the check
+    runs once per step instead of once per layer.
+    """
+    plan = md.__dict__.get(_SLICE_PLAN_ATTR, False)
+    if plan is not False:
+        return plan
+    plan = None
+    masks_cpu = md.spec_sequence_masks_cpu
+    spec_idx = md.spec_token_indx
+    ns_idx = md.non_spec_token_indx
+    if masks_cpu is not None and spec_idx is not None and ns_idx is not None:
+        n_spec = int(md.num_spec_decode_tokens)
+        n_ns = int(md.num_prefill_tokens) + int(md.num_decode_tokens)
+        if (
+            n_spec > 0
+            and n_ns > 0
+            and spec_idx.shape[0] == n_spec
+            and ns_idx.shape[0] == n_ns
+        ):
+            m = masks_cpu.tolist()  # CPU tensor: no device sync
+            k = sum(m)
+            if m == [True] * k + [False] * (len(m) - k):
+                plan = ((0, n_spec), (n_spec, n_ns))  # spec sequences first
+            elif m == [False] * (len(m) - k) + [True] * k:
+                plan = ((n_ns, n_spec), (0, n_ns))  # non-spec sequences first
+            if plan is not None and _KDA_SLICE_VERIFY:
+                # Debug only (one sync per step): the plan must reproduce the
+                # index tensors exactly.
+                (s0, sl), (n0, nl) = plan
+                ok = torch.equal(
+                    spec_idx.to(torch.int64),
+                    torch.arange(s0, s0 + sl, device=spec_idx.device),
+                ) and torch.equal(
+                    ns_idx.to(torch.int64),
+                    torch.arange(n0, n0 + nl, device=ns_idx.device),
+                )
+                if not ok:
+                    raise RuntimeError("KDA slice plan disagrees with token indices")
+    md.__dict__[_SLICE_PLAN_ATTR] = plan
+    return plan
+
