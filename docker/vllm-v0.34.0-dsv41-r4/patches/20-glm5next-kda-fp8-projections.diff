+# VLLM_NEAR_KDA_FP8=1 (read at layer construction) quantizes the KDA in_proj_qkvbfg_a and
+# o_proj linears online to fp8: per-output-channel weight scale, dynamic per-token
+# activation scale. Off by default.
+def _kda_fp8_enabled() -> bool:
+    import os
+
+    return os.environ.get("VLLM_NEAR_KDA_FP8", "0") == "1"
+
+
+def _kda_fp8_quant_config():
+    """Online fp8 config applied to individual KDA linears.
+
+    Same machinery as ``--quantization fp8_per_channel``:
+    ``OnlineQuantizationConfig`` (online/base.py) resolves a ``LinearBase`` layer
+    with weight key ``kFp8StaticChannelSym`` to ``Fp8PtpcOnlineLinearMethod``
+    (online/fp8.py): per-output-channel weight scale, dynamic per-token
+    activation scale, bf16 weights quantized layer-wise at load time.
+    """
+    from vllm.config.quantization import QuantizationConfigArgs
+    from vllm.model_executor.layers.quantization.online.base import (
+        OnlineQuantizationConfig,
+    )
+
+    return OnlineQuantizationConfig(QuantizationConfigArgs(linear="fp8_per_channel"))
+
+
 def _cast_sigmoid(x: torch.Tensor) -> torch.Tensor:
     """Fuse the fp32 cast + sigmoid into one Inductor kernel."""
     return x.float().sigmoid()
