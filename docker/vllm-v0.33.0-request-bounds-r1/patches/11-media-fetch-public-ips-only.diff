+class _PinnedHTTPConnection(Urllib3HTTPConnection):
+    """urllib3 connection that dials pre-validated IPs only.
+
+    Only `_dns_host` (the TCP destination) changes; the `host` property keeps
+    returning the original hostname, so the `Host` header, SNI, and
+    certificate checks are unchanged. Used proxy-free only.
+    """
+
+    _dial_hosts: tuple[str, ...] = ()
+
+    @property  # type: ignore[override]
+    def host(self) -> str:
+        return self._orig_host
+
+    @host.setter
+    def host(self, value: str) -> None:
+        self._orig_host = value
+        self._dns_host = value
+
+    def _new_conn(self) -> socket.socket:
+        return _connect_validated(self, super()._new_conn)
+
+
+class _PinnedHTTPSConnection(Urllib3HTTPSConnection):
+    """TLS sibling of _PinnedHTTPConnection (same split)."""
+
+    _dial_hosts: tuple[str, ...] = ()
+
+    @property  # type: ignore[override]
+    def host(self) -> str:
+        return self._orig_host
+
+    @host.setter
+    def host(self, value: str) -> None:
+        self._orig_host = value
+        self._dns_host = value
+
+    def _new_conn(self) -> socket.socket:
+        return _connect_validated(self, super()._new_conn)
+
+
+# Pool kwargs that plain-HTTP pools accept; the TLS keys requests attaches
+# would break HTTPConnection.__init__.
+_HTTP_POOL_KWARGS = frozenset({"timeout", "maxsize", "block", "headers", "retries"})
+
+# Upper bound on cached per-(host, port, addresses) pools in one adapter.
+_MAX_PINNED_POOLS = 64
+
+
+class _PinnedHTTPConnectionPool(HTTPConnectionPool):
+    ConnectionCls = _PinnedHTTPConnection
+
+    def __init__(self, *args: Any, dial_hosts: tuple[str, ...], **kwargs: Any) -> None:
+        self._dial_hosts = dial_hosts
+        super().__init__(*args, **kwargs)
+
+    def _new_conn(self) -> _PinnedHTTPConnection:
+        conn = super()._new_conn()
+        conn._dial_hosts = self._dial_hosts
+        return conn
+
+
+class _PinnedHTTPSConnectionPool(HTTPSConnectionPool):
+    ConnectionCls = _PinnedHTTPSConnection
+
+    def __init__(self, *args: Any, dial_hosts: tuple[str, ...], **kwargs: Any) -> None:
+        self._dial_hosts = dial_hosts
+        super().__init__(*args, **kwargs)
+
+    def _new_conn(self) -> _PinnedHTTPSConnection:
+        conn = super()._new_conn()
+        conn._dial_hosts = self._dial_hosts
+        return conn
+
+
+class _PinnedPublicIPAdapter(HTTPAdapter):
+    """requests adapter that resolves once, validates, and dials those IPs.
+
+    For every request the hostname is resolved a single time, within the
+    connect timeout, and every answer is IP-validated (_resolve_validated_ips)
+    before any connection opens. A proxy-free request uses a pool that dials
+    only those IPs and keeps the original hostname for the `Host` header,
+    SNI, and certificate checks; the connect and read timeouts are what is
+    left after the lookup. Proxied requests keep default behavior (the proxy
+    dials) after the same hostname validation.
+    """
+
+    def __init__(self, *args: Any, **kwargs: Any) -> None:
+        super().__init__(*args, **kwargs)
+        self._pinned_lock = threading.Lock()
+        self._pinned_pools: OrderedDict[
+            tuple[str, str, int, tuple[str, ...]],
+            HTTPConnectionPool | HTTPSConnectionPool,
+        ] = OrderedDict()
+
+    def close(self) -> None:
+        with self._pinned_lock:
+            pools = list(self._pinned_pools.values())
+            self._pinned_pools.clear()
+        for pool in pools:
+            pool.close()
+        super().close()
+
+    def send(  # type: ignore[override]
+        self,
+        request: requests.PreparedRequest,
+        stream: bool = False,
+        timeout: Any = None,
+        verify: bool | str = True,
+        cert: str | tuple[str, str] | None = None,
+        proxies: Mapping[str, str] | None = None,
+    ) -> requests.Response:
+        connect = timeout[0] if isinstance(timeout, tuple) else timeout
+        if not isinstance(connect, (int, float)):
+            connect = None
+        start = time.monotonic()
+        request._validated_ips = _resolve_validated_ips(  # type: ignore[attr-defined]
+            urlsplit(request.url).hostname or "", connect
+        )
+        if connect is not None:
+            left = connect - (time.monotonic() - start)
+            if left <= 0:
+                raise ConnectTimeout("Media URL host lookup exceeded the timeout")
+            timeout = (left, timeout[1]) if isinstance(timeout, tuple) else left
+        return super().send(request, stream, timeout, verify, cert, proxies)
+
+    def get_connection_with_tls_context(
+        self,
+        request: requests.PreparedRequest,
+        verify: bool | str,
+        proxies: dict[str, str] | None = None,
+        cert: str | tuple[str, str] | None = None,
+    ) -> HTTPConnectionPool | HTTPSConnectionPool:
+        ips = getattr(request, "_validated_ips", None)
+        if ips is None:
+            ips = _resolve_validated_ips(urlsplit(request.url).hostname or "")
+        if select_proxy(request.url, proxies):
+            return super().get_connection_with_tls_context(
+                request, verify, proxies, cert
+            )
+        try:
+            host_params, pool_kwargs = self.build_connection_pool_key_attributes(
+                request, verify, cert
+            )
+        except ValueError as e:
+            raise InvalidURL(e, request=request) from e
+        scheme = host_params["scheme"]
+        host = host_params["host"]
+        port = host_params["port"]
+        key = (scheme, host, port, ips)
+        with self._pinned_lock:
+            pool = self._pinned_pools.get(key)
+            if pool is not None:
+                self._pinned_pools.move_to_end(key)
+            else:
+                if scheme == "https":
+                    pool = _PinnedHTTPSConnectionPool(
+                        host, port, dial_hosts=ips, **pool_kwargs
+                    )
+                else:
+                    safe_kwargs = {
+                        k: v for k, v in pool_kwargs.items() if k in _HTTP_POOL_KWARGS
+                    }
+                    pool = _PinnedHTTPConnectionPool(
+                        host, port, dial_hosts=ips, **safe_kwargs
+                    )
+                self._pinned_pools[key] = pool
+                # Bound the cache; the least recently used pool is closed.
+                while len(self._pinned_pools) > _MAX_PINNED_POOLS:
+                    _, evicted = self._pinned_pools.popitem(last=False)
+                    evicted.close()
+            return pool
+
