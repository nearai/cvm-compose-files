+def _resolve_host_ips(hostname: str) -> list[str]:
+    """Resolve a hostname once, returning every unique IP in answer order."""
+    try:
+        infos = socket.getaddrinfo(hostname, None, type=socket.SOCK_STREAM)
+    except socket.gaierror as e:
+        raise ValueError("Cannot resolve media URL host") from e
+    ips = list(dict.fromkeys(info[4][0] for info in infos))
+    if not ips:
+        raise ValueError("Cannot resolve media URL host: no addresses")
+    return ips
+
+
+# NAT64 well-known prefix: embeds an arbitrary IPv4 address in an IPv6 one.
+_NAT64_NETWORK = ipaddress.ip_network("64:ff9b::/96")
+
+
+def _is_public_ip(ip: str) -> bool:
+    """Whether `ip` is a globally reachable unicast address.
+
+    Multicast and the NAT64 prefix are rejected on top of `is_global`, which
+    is True for both.
+    """
+    try:
+        addr = ipaddress.ip_address(ip)
+    except ValueError:
+        return False
+    if addr.is_multicast:
+        return False
+    if addr.version == 6 and addr in _NAT64_NETWORK:
+        return False
+    return addr.is_global
+
+
+_NON_PUBLIC_IP_MESSAGE = (
+    "Refusing to fetch media URL with a non-public IP. Loopback, private, "
+    "link-local, multicast, NAT64, and reserved destinations are blocked by "
+    "default; set VLLM_MEDIA_URL_ALLOW_PRIVATE_IPS=1 to allow them."
+)
+
+
+def _validate_ips(ips: list[str]) -> tuple[str, ...]:
+    """Return `ips` if every one is a public unicast address, else refuse.
+
+    One non-public answer refuses the whole hostname.
+    `VLLM_MEDIA_URL_ALLOW_PRIVATE_IPS=1` accepts every answer.
+    """
+    if not envs.VLLM_MEDIA_URL_ALLOW_PRIVATE_IPS:
+        for ip in ips:
+            if not _is_public_ip(ip):
+                raise ValueError(_NON_PUBLIC_IP_MESSAGE)
+    return tuple(ips)
+
+
+def _resolve_validated_ips(
+    hostname: str, timeout: float | None = None
+) -> tuple[str, ...]:
+    """Resolve `hostname` once and return its validated addresses.
+
+    These are the only addresses _PinnedPublicIPAdapter connects to, in
+    answer order. With `timeout`, the lookup fails with ConnectTimeout once
+    it runs past it.
+    """
+    if not hostname:
+        raise ValueError("Cannot fetch media URL with a missing hostname")
+    if timeout is None:
+        return _validate_ips(_resolve_host_ips(hostname))
+    if timeout <= 0:
+        raise ConnectTimeout("Media URL host lookup exceeded the timeout")
+    future = _RESOLVER_POOL.submit(_resolve_host_ips, hostname)
+    try:
+        ips = future.result(timeout=timeout)
+    except TimeoutError as e:
+        future.cancel()
+        raise ConnectTimeout("Media URL host lookup exceeded the timeout") from e
+    return _validate_ips(ips)
+
+
+def _time_left(deadline: float | None) -> float | None:
+    """Seconds left before `deadline`; TimeoutError once it has passed."""
+    if deadline is None:
+        return None
+    left = deadline - time.monotonic()
+    if left <= 0:
+        raise TimeoutError("Media fetch exceeded the timeout")
+    return left
+
+
+def _check_allowed_domains(url: str, allowed_domains: Collection[str] | None) -> None:
+    """Check one redirect hop against the domain allowlist.
+
+    Applies MediaConnector._assert_url_in_allowed_media_domains to every hop.
+    An empty or missing allowlist allows every domain.
+    """
+    if not allowed_domains:
+        return
+    hostname = urlsplit(url).hostname
+    if hostname not in allowed_domains:
+        raise ValueError("The URL must be from one of the allowed domains.")
+
