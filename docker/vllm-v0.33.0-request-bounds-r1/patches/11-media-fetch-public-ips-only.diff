+def _connect_validated(conn: Any, new_conn: Callable[[], socket.socket]):
+    """Open the socket of a pinned connection to the first reachable address.
+
+    The addresses are tried in order. The connect timeout covers all of them:
+    each attempt gets the time left divided by the addresses left.
+    """
+    hosts = conn._dial_hosts
+    timeout = conn.timeout
+    deadline = time.monotonic() + timeout if isinstance(timeout, (int, float)) else None
+    error: ConnectTimeoutError | None = None
+    try:
+        for index, ip in enumerate(hosts):
+            if deadline is not None:
+                left = deadline - time.monotonic()
+                if left <= 0:
+                    break
+                conn.timeout = left / (len(hosts) - index)
+            conn._dns_host = ip
+            try:
+                sock = new_conn()
+            except ConnectTimeoutError as e:
+                error = e
+                continue
+            if deadline is not None:
+                left = deadline - time.monotonic()
+                if left <= 0:
+                    sock.close()
+                    break
+                sock.settimeout(left)
+            return sock
+    finally:
+        conn.timeout = timeout
+    raise error or ConnectTimeoutError(conn, "Connection timed out")
+
