+# Tokens held back while the text ends in an incomplete UTF-8 sequence. A run
+# this long is flushed, so the per-token decode cost stays bounded.
+MAX_PENDING_TOKENS = 16
+
+_Item = TypeVar("_Item")
+
+
+def incomplete_utf8_suffix_len(
+    decode: Callable[[Sequence[_Item]], str], items: Sequence[_Item]
+) -> int:
+    """Number of trailing `items` to keep back when a held-back run is flushed.
+
+    The kept tail is at most 3 items (the bytes of an incomplete character),
+    ends in U+FFFD, and splitting it off leaves the decoded text unchanged, so
+    the flushed text is final and later items can still complete the tail.
+    """
+    whole = decode(items)
+    for n in range(min(3, len(items) - 1), 0, -1):
+        tail = decode(items[-n:])
+        if tail.endswith("�") and decode(items[:-n]) + tail == whole:
+            return n
+    return 0
+
 
