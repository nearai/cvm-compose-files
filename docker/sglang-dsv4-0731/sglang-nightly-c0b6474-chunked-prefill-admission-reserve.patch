+# Downstream safety control for latency-sensitive mixed workloads. The stock
+# scheduler always spends the entire chunk budget on an in-flight long prefill,
+# so requests that arrive after it cannot enter the same prefill batch. Reserve
+# part of that budget for complete waiting requests. Zero preserves upstream
+# behavior; production candidates must set and qualify an explicit value.
+CHUNKED_PREFILL_ADMISSION_RESERVE = int(
+    os.environ.get("SGLANG_CHUNKED_PREFILL_ADMISSION_RESERVE", "0")
+)
+if CHUNKED_PREFILL_ADMISSION_RESERVE < 0:
