+    def _punica_wrapper(self):
+        """The LoRA punica wrapper the replay layers' wo_b uses, or None without LoRA.
+
+        Looked up on each call until found: LoRA wraps the layers after construction."""
+        if getattr(self, "_punica", None) is None:
+            model = getattr(self.run_layers, "__self__", None)
+            for layer in getattr(model, "layers", ()):
+                wrapper = getattr(getattr(getattr(layer, "attn", None), "wo_b", None), "punica_wrapper", None)
+                if wrapper is not None:
+                    self._punica = wrapper
+                    break
+        return getattr(self, "_punica", None)
