+    def _near_bufs(self, n: int) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        bufs = getattr(self, "_near_pinned", None)
+        if bufs is None or bufs[0].shape[0] < n:
+            cap = max(n, 1 << 16)
+            bufs = (
+                torch.empty((cap, self.dim), dtype=torch.uint8, pin_memory=True),
+                torch.empty((cap, self.dim // self.block_size), dtype=torch.uint8, pin_memory=True),
+                torch.empty((cap,), dtype=torch.bool, pin_memory=True),
+            )
+            self._near_pinned = bufs
+        return bufs
+
+    def near_lookup_cpu_ids(self, ids_cpu: torch.Tensor, out: torch.Tensor) -> None:
+        """_near_cpu_lookup with the hash ids already on the host (one sync per step for
+        all layers): gather into this table's pinned buffers, copy to the GPU without
+        blocking, dequantize there. Each layer owns its buffers, and the next step's
+        host sync orders their reuse after these copies."""
+        num_tokens, local_heads = ids_cpu.shape[0], self.part_n_hash_cols
+        if num_tokens == 0:
+            return
+        head_end = min(self.head_start + local_heads, self.n_hash_cols)
+        ids = ids_cpu[:, self.head_start : head_end].to(torch.int64)
+        heads = ids.shape[1]
+        local = ids - self.vocab_start_idx
+        owned = (local >= 0) & (local < self.part_num_embeddings)
+        local = torch.where(owned, local, 0).reshape(-1)
+        n = local.numel()
+        if self._shared_memory is not None:
+            weight_cpu = self._shared_memory.weight
+            scale_cpu = self._shared_memory.weight_scale_inv
+        else:
+            weight_cpu, scale_cpu = self.weight.data, self.weight_scale_inv.data
+        vbuf, sbuf, obuf = self._near_bufs(n)
+        vals, scs, own = vbuf[:n], sbuf[:n], obuf[:n]
+        torch.index_select(weight_cpu.view(torch.uint8), 0, local, out=vals)
+        torch.index_select(scale_cpu, 0, local, out=scs)
+        own.copy_(owned.reshape(-1))
+        dev = out.device
+        values = vals.to(dev, non_blocking=True).view(torch.float8_e4m3fn).float()
+        scale = torch.exp2(scs.to(dev, non_blocking=True).float() - 127.0)
+        keep = own.to(dev, non_blocking=True)
+        dim, block = self.dim, self.block_size
+        deq = (values.view(-1, dim // block, block) * scale.unsqueeze(-1)).view(
+            num_tokens, heads, dim
+        )
+        deq = deq * keep.view(num_tokens, heads, 1)
+        dest = out.view(num_tokens, local_heads, dim)
+        dest[:, :heads].copy_(deq)
+        if heads < local_heads:
+            dest[:, heads:].zero_()
