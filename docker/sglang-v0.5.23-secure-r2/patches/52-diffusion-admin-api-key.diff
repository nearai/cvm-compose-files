+# Bearer keys for the HTTP API, read from the environment (never argv or
+# server_args, so they stay out of `ps`, logs and /server_info). Same semantics
+# as the LLM server's --api-key / --admin-api-key (sglang.srt.utils.auth):
+# - API_KEY: required on every route except /health*, /metrics;
+# - ADMIN_API_KEY: required on admin routes (LoRA, weight updates, memory
+#   release, rollout); when both are set, admin routes accept only the admin key.
+API_KEY_ENV = "SGLANG_DIFFUSION_API_KEY"
+ADMIN_API_KEY_ENV = "SGLANG_DIFFUSION_ADMIN_API_KEY"
+
+
+def _configured_api_keys() -> tuple[str | None, str | None]:
+    return (
+        os.environ.get(API_KEY_ENV) or None,
+        os.environ.get(ADMIN_API_KEY_ENV) or None,
+    )
+
+
+def _admin_paths(*routers: APIRouter) -> frozenset[str]:
+    """Paths of the routes marked @auth_level(ADMIN_OPTIONAL) in these routers.
+
+    The srt middleware resolves the level by matching app.routes, which does not
+    look inside routers added with include_router (all routes here), so the
+    level is looked up by exact path instead.
+    """
+    return frozenset(
+        route.path
+        for router in routers
+        for route in router.routes
+        if getattr(getattr(route, "endpoint", None), "_auth_level", None)
+        == AuthLevel.ADMIN_OPTIONAL
+    )
+
+
+def _add_api_key_middleware(
+    app: FastAPI,
