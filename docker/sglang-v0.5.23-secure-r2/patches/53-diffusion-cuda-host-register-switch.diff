+# cudaHostRegister is not supported in some environments (confidential-computing
+# VMs such as TDX with protected PCIe return cudaErrorNotSupported). Setting this
+# env var skips it: every pinned buffer then comes from torch's pinned pool
+# (cudaHostAlloc), as below _REGISTER_MIN_BYTES. Default: unchanged.
+DISABLE_HOST_REGISTER_ENV = "SGLANG_DIFFUSION_DISABLE_CUDA_HOST_REGISTER"
+
