+def _clear_cuda_runtime_error() -> None:
+    """Reset the CUDA runtime's per-thread last error after a handled failure.
+
+    torch's cudaHostRegister binding returns the error code but leaves it as the
+    runtime's last error, and the next kernel launch check (cudaGetLastError)
+    then raises it from an unrelated op, e.g. a later module.to(). torch exposes
+    no cudaGetLastError, so call it on the libcudart torch itself loaded.
+    """
+    try:
+        paths = set()
+        with open("/proc/self/maps") as maps:
+            for line in maps:
+                fields = line.split()
+                if len(fields) >= 6 and "/libcudart.so" in fields[5]:
+                    paths.add(fields[5])
+        for path in sorted(paths):
+            ctypes.CDLL(path).cudaGetLastError()
+    except Exception:
+        pass
+
+
