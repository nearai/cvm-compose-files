@@ -1938,6 +1938,24 @@ def get_mm_http_session() -> requests.Session:
     return session
 
 
+# Media inputs come from request bodies. A file:// URL or a bare server path
+# would let any caller read local files into the model, so the loaders below
+# refuse them unless the operator opts in (offline Engine use, tests).
+LOCAL_MEDIA_ENV = "SGLANG_ALLOW_LOCAL_MEDIA_PATHS"
+
+
+def local_media_allowed() -> bool:
+    return get_bool_env_var(LOCAL_MEDIA_ENV)
+
+
+def check_local_media_allowed() -> None:
+    if not local_media_allowed():
+        raise ValueError(
+            "Local file paths and file:// URLs are not accepted for media inputs; "
+            "send an http(s) URL or a data: URL."
+        )
+
+
 # Raised by the loaders below when client-supplied media cannot be fetched or
 # decoded. ValueError is in the set because invalid base64 raises binascii.Error.
 CLIENT_MEDIA_EXCEPTIONS = (
@@ -1964,8 +1982,10 @@ def load_audio(
