diff --git a/python/sglang/multimodal_gen/runtime/utils/url_guard.py b/python/sglang/multimodal_gen/runtime/utils/url_guard.py
new file mode 100644
index 0000000..bf5c8d9
--- /dev/null
+++ b/python/sglang/multimodal_gen/runtime/utils/url_guard.py
@@ -0,0 +1,230 @@
+"""Outbound policy for client-supplied media URLs (SSRF guard).
+
+A request may name an http(s) URL that the server then fetches. Without a
+check, that URL can point at loopback, the container network or a cloud
+metadata service. Every fetch of a client URL goes through this module:
+
+1. only http and https URLs with a host are accepted;
+2. the host is resolved once and every address must be public (not private,
+   loopback, link-local, CGNAT, multicast, reserved or unspecified, including
+   IPv4 addresses embedded in IPv6 forms);
+3. the connection goes to the address that was checked (the URL host is
+   replaced by the IP, with the original Host header and TLS server name), so
+   a DNS answer cannot change between the check and the connection;
+4. redirects are followed by hand, at most MAX_REDIRECTS, and each target is
+   checked the same way.
+
+SGLANG_DIFFUSION_ALLOW_PRIVATE_MEDIA_URLS=1 turns off the address check (2, 3)
+for lab setups that serve test images from a private host. Scheme checks and
+the redirect limit stay on.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import ipaddress
+import os
+import socket
+from contextlib import asynccontextmanager, contextmanager
+from typing import AsyncIterator, Iterator
+from urllib.parse import urljoin, urlsplit, urlunsplit
+
+import httpx
+
+ALLOW_PRIVATE_ENV = "SGLANG_DIFFUSION_ALLOW_PRIVATE_MEDIA_URLS"
+MAX_REDIRECTS = 5
+_REDIRECT_STATUS_CODES = frozenset({301, 302, 303, 307, 308})
+_DEFAULT_PORTS = {"http": 80, "https": 443}
+_NAT64_NETWORKS = (
+    ipaddress.ip_network("64:ff9b::/96"),
+    ipaddress.ip_network("64:ff9b:1::/48"),
+)
+_IPV4_COMPATIBLE = ipaddress.ip_network("::/96")
+
+IPAddress = ipaddress.IPv4Address | ipaddress.IPv6Address
+
+
+class BlockedURLError(ValueError):
+    """The URL is not allowed by the outbound media URL policy."""
+
+
+def private_urls_allowed() -> bool:
+    return os.environ.get(ALLOW_PRIVATE_ENV, "").strip().lower() in (
+        "1",
+        "true",
+        "yes",
+        "on",
+    )
+
+
+def is_public_address(ip: IPAddress) -> bool:
+    """True only for a globally routable unicast address."""
+    if isinstance(ip, ipaddress.IPv6Address):
+        if ip in _IPV4_COMPATIBLE:
+            return False
+        embedded = [ip.ipv4_mapped, ip.sixtofour]
+        if ip.teredo is not None:
+            embedded.append(ip.teredo[1])
+        if any(ip in net for net in _NAT64_NETWORKS):
+            embedded.append(ipaddress.IPv4Address(int(ip) & 0xFFFFFFFF))
+        for inner in embedded:
+            if inner is not None and not is_public_address(inner):
+                return False
+    return bool(
+        ip.is_global
+        and not ip.is_multicast
+        and not ip.is_private
+        and not ip.is_loopback
+        and not ip.is_link_local
+        and not ip.is_reserved
+        and not ip.is_unspecified
+    )
+
+
+def _split_http_url(url: str):
+    if not isinstance(url, str):
+        raise BlockedURLError("media URL must be a string")
+    try:
+        parts = urlsplit(url.strip())
+        port = parts.port
+    except ValueError as e:
+        raise BlockedURLError("invalid media URL") from e
+    scheme = parts.scheme.lower()
+    if scheme not in _DEFAULT_PORTS or not parts.hostname:
+        raise BlockedURLError("only http and https media URLs are allowed")
+    return parts, scheme, port
+
+
+def resolve_public_addresses(host: str, port: int) -> list[IPAddress]:
+    """Resolve `host` and require every address to be public."""
+    try:
+        literal = ipaddress.ip_address(host)
+    except ValueError:
+        literal = None
+    if literal is not None:
+        addresses = [literal]
+    else:
+        try:
+            infos = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
+        except (socket.gaierror, UnicodeError) as e:
+            raise BlockedURLError("media URL host does not resolve") from e
+        addresses = []
+        for info in infos:
+            ip = ipaddress.ip_address(info[4][0].split("%", 1)[0])
+            if ip not in addresses:
+                addresses.append(ip)
+    if not addresses:
+        raise BlockedURLError("media URL host does not resolve")
+    for ip in addresses:
+        if not is_public_address(ip):
+            raise BlockedURLError("media URL resolves to a non-public address")
+    return addresses
+
+
+def pinned_request(url: str) -> tuple[str, dict[str, str], dict[str, bytes]]:
+    """Check `url` and return (request_url, headers, httpx extensions).
+
+    The request URL carries the checked IP; the Host header and TLS server name
+    keep the original host so virtual hosting and certificate checks still work.
+    """
+    parts, scheme, port = _split_http_url(url)
+    clean = urlunsplit((scheme, parts.netloc.rsplit("@", 1)[-1], parts.path, parts.query, ""))
+    if private_urls_allowed():
+        return clean, {}, {}
+
+    host = parts.hostname
+    try:
+        ascii_host = host.encode("idna").decode("ascii")
+    except UnicodeError as e:
+        raise BlockedURLError("invalid media URL host") from e
+    addresses = resolve_public_addresses(ascii_host, port or _DEFAULT_PORTS[scheme])
+    ip = addresses[0]
+    ip_text = f"[{ip}]" if ip.version == 6 else str(ip)
+    port_suffix = f":{port}" if port else ""
+    request_url = urlunsplit(
+        (scheme, ip_text + port_suffix, parts.path, parts.query, "")
+    )
+    host_text = f"[{ascii_host}]" if ":" in ascii_host else ascii_host
+    headers = {"Host": host_text + port_suffix}
+    extensions: dict[str, bytes] = {}
+    is_literal = True
+    try:
+        ipaddress.ip_address(ascii_host)
+    except ValueError:
+        is_literal = False
+    if scheme == "https" and not is_literal:
+        extensions["sni_hostname"] = ascii_host.encode("ascii")
+    return request_url, headers, extensions
+
+
+def _redirect_target(current: str, response: httpx.Response) -> str | None:
+    location = response.headers.get("location")
+    if response.status_code in _REDIRECT_STATUS_CODES and location:
+        return urljoin(current, location)
+    return None
+
+
+@asynccontextmanager
+async def open_public_url_async(
+    client: httpx.AsyncClient, url: str, *, timeout: float
+) -> AsyncIterator[httpx.Response]:
+    """Stream GET `url` under the policy; `client` must not follow redirects."""
+    current = url
+    for hop in range(MAX_REDIRECTS + 1):
+        request_url, headers, extensions = await asyncio.to_thread(
+            pinned_request, current
+        )
+        async with client.stream(
+            "GET",
+            request_url,
+            headers=headers,
+            extensions=extensions,
+            timeout=timeout,
+            follow_redirects=False,
+        ) as response:
+            target = _redirect_target(current, response)
+            if target is None:
+                yield response
+                return
+        if hop == MAX_REDIRECTS:
+            raise BlockedURLError(f"media URL exceeded {MAX_REDIRECTS} redirects")
+        current = target
+
+
+@contextmanager
+def open_public_url(url: str, *, timeout: float) -> Iterator[httpx.Response]:
+    """Synchronous `open_public_url_async` with its own client."""
+    current = url
+    with httpx.Client(follow_redirects=False) as client:
+        for hop in range(MAX_REDIRECTS + 1):
+            request_url, headers, extensions = pinned_request(current)
+            with client.stream(
+                "GET",
+                request_url,
+                headers=headers,
+                extensions=extensions,
+                timeout=timeout,
+                follow_redirects=False,
+            ) as response:
+                target = _redirect_target(current, response)
+                if target is None:
+                    yield response
+                    return
+            if hop == MAX_REDIRECTS:
+                raise BlockedURLError(f"media URL exceeded {MAX_REDIRECTS} redirects")
+            current = target
+
+
+def fetch_public_url_bytes(url: str, *, timeout: float, max_bytes: int) -> bytes:
+    """GET `url` under the policy and return at most `max_bytes` of body."""
+    with open_public_url(url, timeout=timeout) as response:
+        response.raise_for_status()
+        declared = response.headers.get("content-length")
+        if declared and declared.isdigit() and int(declared) > max_bytes:
+            raise ValueError(f"media URL body exceeds the {max_bytes} byte limit")
+        body = bytearray()
+        for chunk in response.iter_bytes():
+            body += chunk
+            if len(body) > max_bytes:
+                raise ValueError(f"media URL body exceeds the {max_bytes} byte limit")
+        return bytes(body)
