+    def forward_batch_split_prefill(self, batch: ScheduleBatch):
+        """PDMux layerwise prefill for EAGLE (port of sglang PR #42414).
+
+        Target slices run exactly as without speculation, except that hidden
+        states are captured for every token. After the final slice the draft
+        model extends over the prompt on the prefill stream (prefill TP
+        placement, set by the scheduler loop) and the resulting
+        EagleDraftInput is returned for the scheduler to attach before the
+        merge. Overlap schedule is off, so there is no future_map relay.
+        """
+        batch_output = self.target_worker.forward_batch_split_prefill(
+            batch, capture_hidden_mode=CaptureHiddenMode.FULL
+        )
+        forward_batch = batch.split_forward_batch
+        if (
+            forward_batch.split_index
+            < self.target_worker.model_runner.model_config.num_hidden_layers
+        ):
+            return batch_output
+
+        # Spec_v2 convention: batch.seq_lens = length BEFORE this iter's tokens.
+        # Extend processed L prompt tokens; next verify iter expects same L.
+        batch_output.new_seq_lens = batch.seq_lens
+        if self._draft_worker is None:
             return batch_output
 
+        # The scheduler releases ScheduleBatch.input_ids after every slice. The
+        # persistent ForwardBatch still owns them. Draft rotation / spec_info
+        # must not mutate the split target batch, so work on a shallow view.
+        draft_batch = copy.copy(batch)
+        draft_batch.input_ids = forward_batch.input_ids[: batch.extend_num_tokens]
+        if not draft_batch.forward_mode.is_idle():
+            draft_batch.forward_mode = ForwardMode.EXTEND
+        draft_batch.sampling_info = batch.sampling_info.copy_for_forward()
+
+        # Draft prefill and draft decode(-extend) share planner / index-share
+        # scratch. Wait for decode work already enqueued; target slices before
+        # this point stay concurrent with decode.
+        from sglang.srt.multiplex.pdmux_context import (
+            get_current_stream_idx,
+            get_stream_groups,
+        )
+
+        prefill_stream, decode_stream = get_stream_groups()[get_current_stream_idx()]
+        prefill_stream.wait_stream(decode_stream)
+        with (
+            self.draft_worker.draft_tp_context(
+                self.draft_worker.draft_runner.tp_group
+            ),
+            speculative_moe_backend_context(),
+            speculative_moe_a2a_backend_context(),
+            spec_stage_span("draft_extend"),
+        ):
