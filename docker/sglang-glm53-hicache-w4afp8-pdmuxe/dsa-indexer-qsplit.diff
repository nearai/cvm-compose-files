+        pool_lens, seq_lens_expanded, ks_per_q, ke_per_q,
+    ) -> torch.Tensor:
+        world, rank = group.world_size, group.rank_in_group
+        per = -(-n_real // world)
+        lo, hi = min(rank * per, n_real), min((rank + 1) * per, n_real)
+        page_table = page_table_row_index = topk_offsets = None
