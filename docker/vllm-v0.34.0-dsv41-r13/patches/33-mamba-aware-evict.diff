+# SPDX-License-Identifier: Apache-2.0
+"""NEAR lab: hybrid Mamba/KDA-aware prefix-cache eviction.
+
+``VLLM_NEAR_MAMBA_AWARE_EVICT`` (read when the KV cache manager is built):
+
+- unset, ``0``, ``false``, ``no``, ``off``: stock behaviour (default).
+- ``1``, ``true``, ``yes``, ``on``, ``all``: both parts below.
+- ``hold``: only the boundary-state hold and free order (upstream #61282).
+- ``lru``: only the superseded-state demotion (upstream #63808).
+
+Any other value stops the engine at startup.
+"""
+
+import os
+
+ENV_NAME = "VLLM_NEAR_MAMBA_AWARE_EVICT"
+
+_OFF = ("", "0", "false", "no", "off")
+_ALL = ("1", "true", "yes", "on", "all")
+
+
+def mamba_aware_evict_modes() -> tuple[bool, bool]:
+    """Return ``(hold_boundary_state, demote_superseded_states)``."""
+    raw = os.environ.get(ENV_NAME, "").strip().lower()
+    if raw in _OFF:
+        return False, False
+    if raw in _ALL:
+        return True, True
+    if raw == "hold":
+        return True, False
+    if raw == "lru":
+        return False, True
+    raise ValueError(
+        f"{ENV_NAME} must be one of 0, 1, hold or lru (got a value of "
+        f"length {len(raw)})"
+    )
