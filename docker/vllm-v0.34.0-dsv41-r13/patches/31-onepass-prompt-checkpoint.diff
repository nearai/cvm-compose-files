+def get_mamba_onepass_checkpoint_col(
+    query_start: int,
+    query_end: int,
+    checkpoint_position: int,
+    hash_block_size: int,
+    mamba_block_size: int,
+    checkpoint_alignment: int | None,
+    num_speculative_blocks: int,
+) -> int:
+    """Block-table column for a one-pass checkpoint, or -1 when there is none.
+
+    NEAR lab (VLLM_NEAR_ONEPASS_CKPT=1). ``is_mamba_prefill_checkpoint_valid``
+    stores the checkpoint in column ``cdiv(query_end, B) - 2``, which is only
+    free when the query crosses a block boundary. A query that stays inside
+    one block (the warm short tail) has no such column, so the scheduler used
+    to end the chunk at the checkpoint and run the rest in a second pass.
+
+    Here the checkpoint goes to the first speculative scratch column,
+    ``cdiv(query_end, B)``, right after the running-state column. A prefill
+    step never reads or writes that column, and it is a block the request owns
+    alone. The manager keys it at ``checkpoint_position`` and copies it out
+    (the existing running-request CoW) before the next step's forward, which
+    writes speculative states there.
+
+    The last condition keeps that next step (at most ``1 + S`` tokens) inside
+    the same block, so the running state does not move into the scratch
+    column in the step that copies it out.
+
+    The scheduler, ``MambaManager`` and the worker's
+    ``compute_mamba_prefill_checkpoints`` all call this, so they agree.
+    """
+    if checkpoint_alignment is None or num_speculative_blocks < 1:
+        return -1
+    assert checkpoint_alignment > 0
+    if query_end <= query_start:
+        return -1
+    block_idx = query_start // mamba_block_size
+    if (query_end - 1) // mamba_block_size != block_idx:
+        return -1
+    if not (
+        query_start % hash_block_size == 0
+        and query_start + hash_block_size <= checkpoint_position
+        and query_start < checkpoint_position < query_end
+        and (checkpoint_position - query_start) % checkpoint_alignment == 0
+    ):
+        return -1
+    if (query_end + num_speculative_blocks) // mamba_block_size != block_idx:
+        return -1
+    return block_idx + 1
+
+
