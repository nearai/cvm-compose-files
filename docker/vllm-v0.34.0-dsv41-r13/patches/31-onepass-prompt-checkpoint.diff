+    def _cache_onepass_checkpoint(
+        self, request: Request, checkpoint_position: int, block_idx: int
+    ) -> BlockHashWithGroupId | None:
+        """Key the scratch block the worker exported a one-pass checkpoint into.
+
+        NEAR lab (VLLM_NEAR_ONEPASS_CKPT=1). The block at ``block_idx`` is the
+        request's first speculative scratch block: this step's forward writes
+        ``checkpoint_position``'s state there and nothing else. The next step's
+        forward writes speculative states into it, so it is registered as this
+        request's own partial tail: the next allocation moves the key to a CoW
+        block and copies it there before that forward (the same path the
+        two-pass split takes after its first pass). If the request ends first,
+        the block is freed with its key and is never written again.
+        """
+        prompt_checkpoint = get_mamba_prefill_checkpoint_position(
+            request.num_prompt_tokens,
+            self.cache_hit_alignment_tokens,
+            self.drop_eagle_checkpoint_block,
+            num_hash_lookahead_tokens=self.block_pool.num_hash_lookahead_tokens,
+        )
+        if checkpoint_position != prompt_checkpoint:
+            # Not the prompt's reusable boundary: leave the scratch unkeyed.
+            return None
+        blocks = self.req_to_blocks[request.request_id]
+        assert 0 <= block_idx < len(blocks)
+        block = blocks[block_idx]
+        # The worker has already been told to write this block: it must be a
+        # private, unkeyed scratch block, or a shared block was overwritten.
+        assert self.block_pool.is_block_writable(block), (
+            "one-pass Mamba checkpoint column is not a private scratch block"
+        )
+        partial_hash = self.block_pool.cache_partial_block(
+            request=request,
+            block=block,
+            num_tokens=checkpoint_position,
+            kv_cache_group_id=self.kv_cache_group_id,
+            block_size=self.block_size,
+        )
+        if partial_hash is not None:
+            self._partial_hit_reqs[request.request_id] = (block_idx, block)
+            self._producer_partial_tail_reqs[request.request_id] = (
+                block,
+                checkpoint_position,
+            )
+        return partial_hash
