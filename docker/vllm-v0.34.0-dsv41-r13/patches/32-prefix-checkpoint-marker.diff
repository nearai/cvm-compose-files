+    def _cache_stable_prefix_checkpoint(
+        self, request: Request, chunk_range: tuple[int, int]
+    ) -> BlockHashWithGroupId | None:
+        """Key the running state block at the request's stable-prefix checkpoint.
+
+        NEAR lab (VLLM_NEAR_PREFIX_CKPT=1). The scheduler sets
+        ``request.near_prefix_ckpt`` (P) and ends a fresh prompt's chunk there
+        (``near_prefix_ckpt.prefix_checkpoint_stop``). This step's forward
+        leaves the state after exactly P tokens in the running block, the same
+        place the prompt's split tail checkpoint lands, so it is keyed and
+        handed to the next allocation's copy-on-write exactly like that tail.
+
+        Keyed on the scheduled chunk's end, not on ``num_tokens``: with
+        multi-module MTP the coordinator passes ``num_computed`` minus the
+        re-prefillable tokens, but the Mamba state at the chunk end is final
+        (draft modules have no Mamba layers). Full-attention keys still lag
+        by those tokens, so a hit at P is only possible once the owner's next
+        chunk has finalized them; the reconciled hit is the minimum of both.
+        """
+        position = request.near_prefix_ckpt
+        query_start, query_end = chunk_range
+        if (
+            query_end != position
+            or not query_start < position <= request.num_prompt_tokens
+            or position % self.block_size == 0
+            or position % self.block_pool.hash_block_size != 0
