+    def _alloc_host_buffer_hostalloc(self, nbytes: int) -> torch.Tensor:
+        """Whole pool in one cudaHostAlloc, wrapped as an int8 CPU tensor."""
+        page = mmap.PAGESIZE
+        nbytes = (max(nbytes, 1) + page - 1) // page * page
+        ptr = _cuda_host_alloc(nbytes)
+        self._hostalloc_ptr = ptr
+        self._hostalloc_nbytes = nbytes
+        atexit.register(self.shutdown)
+        logger.info(
+            "SimpleCPUOffloadWorker [CPU]: host pool bytes=%d method=cudaHostAlloc",
+            nbytes,
+        )
+        arr = (ctypes.c_int8 * nbytes).from_address(ptr)
+        return torch.frombuffer(arr, dtype=torch.int8)
+
+    def _carve_hostalloc_caches(
+        self, unique_gpu_caches: dict[str, torch.Tensor], layer_bytes: list[int]
+    ) -> dict[str, torch.Tensor]:
+        # Driver-allocated pinned memory: no pin_tensor / registration ranges.
+        buf = self._alloc_host_buffer_hostalloc(sum(layer_bytes))
+        cpu_kv_caches = {}
+        offset = 0
+        for size, (name, gpu_tensor) in zip(layer_bytes, unique_gpu_caches.items()):
+            cpu_shape = (self.num_cpu_blocks,) + gpu_tensor.shape[1:]
+            view = buf[offset : offset + size].view(gpu_tensor.dtype)
+            cpu_kv_caches[name] = view.view(cpu_shape)
+            offset += size
+        return cpu_kv_caches
+
+    def shutdown(self) -> None:
+        """Free the cudaHostAlloc pool (no-op on the default path)."""
+        ptr, self._hostalloc_ptr = self._hostalloc_ptr, None
+        if ptr is None:
+            return
+        self.cpu_kv_caches = None
+        try:
+            err = _cuda_free_host(ptr)
+            if err != 0:
+                logger.warning("cudaFreeHost failed (code=%d)", err)
+        except Exception:
+            logger.warning("cudaFreeHost raised", exc_info=False)
