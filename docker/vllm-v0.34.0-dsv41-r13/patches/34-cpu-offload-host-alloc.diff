+# --- CC-safe host pool: cudaHostAlloc instead of mmap + cudaHostRegister ---
+_HOSTALLOC_ENV = "VLLM_NEAR_CPU_OFFLOAD_HOSTALLOC"
+_cudart_lib = None
+
+
+def _hostalloc_enabled() -> bool:
+    return os.environ.get(_HOSTALLOC_ENV, "0") == "1"
+
+
+def _get_cudart():
+    """Load libcudart through ctypes (torch.cuda.cudart() has no cudaHostAlloc)."""
+    global _cudart_lib
+    if _cudart_lib is None:
+        path = find_loaded_library("libcudart")
+        lib = None
+        for cand in (path, "libcudart.so.13", "libcudart.so.12", "libcudart.so"):
+            if not cand:
+                continue
+            try:
+                lib = ctypes.CDLL(cand)
+                break
+            except OSError:
+                continue
+        if lib is None:
+            raise RuntimeError("cannot load libcudart for cudaHostAlloc")
+        lib.cudaHostAlloc.argtypes = [
+            ctypes.POINTER(ctypes.c_void_p),
+            ctypes.c_size_t,
+            ctypes.c_uint,
+        ]
+        lib.cudaHostAlloc.restype = ctypes.c_int
+        lib.cudaFreeHost.argtypes = [ctypes.c_void_p]
+        lib.cudaFreeHost.restype = ctypes.c_int
+        _cudart_lib = lib
+    return _cudart_lib
+
+
+def _cuda_host_alloc(nbytes: int) -> int:
+    """One cudaHostAlloc(nbytes, cudaHostAllocDefault); returns the address."""
+    ptr = ctypes.c_void_p()
+    err = _get_cudart().cudaHostAlloc(ctypes.byref(ptr), nbytes, 0)
+    if err != 0 or not ptr.value:
+        raise RuntimeError(f"cudaHostAlloc failed (code={err}, bytes={nbytes})")
+    return ptr.value
+
+
+def _cuda_free_host(ptr: int) -> int:
+    return _get_cudart().cudaFreeHost(ctypes.c_void_p(ptr))
+
