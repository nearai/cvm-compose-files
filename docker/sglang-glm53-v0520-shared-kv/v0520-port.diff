+class PooledL2:
+    def __init__(self, io_backend):
+        assert io_backend == "direct"
+        assert torch.cuda.is_available() and torch.version.hip is None
+        self.backup_enabled = self.restore_enabled = self.clone_enabled = True
+        self.pages = int(os.environ.get("SGLANG_HICACHE_STAGING_PAGES", "64"))
+        assert 1 <= self.pages <= 128
+        self.staging = {}
+        self.logged = set()
+
+    def _log_once(self, name):
+        if name not in self.logged:
+            logger.info("Pooled L2 transfer executed: %s", name)
+            self.logged.add(name)
+
+    @staticmethod
+    def _buffers(t):
+        h, d = t.host_pool, t.device_pool
+        if h.layout != "page_first_direct" or getattr(h, "dcp_size", 1) != 1:
+            return None
+        if t.host_indices.device.type != "cpu" or t.device_indices.device.type != "cpu":
+            return None
+        if type(h) is MLATokenToKVPoolHost and isinstance(d, MLATokenToKVPool):
+            if h.device_pool is not d or h._is_device_layer_sharded(d):
+                return None
+            _, buffers = h._resolve_device_transfer_buffers(d)
+            if len(buffers) != h.layer_num:
+                return None
+            if any(
+                b.shape[0] % h.page_size
+                or b[0].nbytes != h.kv_cache_dim * h.dtype.itemsize
+                for b in buffers
+            ):
+                return None
+            return buffers
+        if type(h) is DeepSeekV4PagedHostPool and h.page_aligned_only:
+            if any(
+                b.ndim != 2 or b.shape[1] * b.element_size() != h.item_bytes
+                for b in h.device_buffers
+            ):
+                return None
+            return h.device_buffers
+        return None
+
+    def _stage(self, t, direction):
+        key = (id(t.host_pool), id(t.device_pool), direction)
+        if key not in self.staging:
+            buffers = self._buffers(t)
+            assert buffers is not None
+            self.staging[key] = PooledPages(
+                buffers,
+                t.host_pool.kv_buffer,
+                tokens_per_page=t.host_pool.page_size,
+                staging_pages=self.pages,
+            )
+        return self.staging[key]
+
+    def backup(self, t):
+        if not self.backup_enabled or self._buffers(t) is None:
+            return False
+        self._stage(t, "D2H").transfer(t.host_indices, t.device_indices, restore=False)
+        self._log_once(type(t.host_pool).__name__ + "-pooled-D2H")
+        return True
+
+    def prepare_restore(self, transfers, layer_num):
+        preloaded = set()
+        for i, t in enumerate(transfers):
+            if i in preloaded or not self.restore_enabled or self._buffers(t) is None:
+                continue
+            # Packed MTP uses a second L2Transfer for the same host pool:
+            # target layers map to their model positions, draft layers map to
+            # early draft-consumer positions. Restore the complete packed pool
+            # once, before either consumer; only then skip both descriptors.
+            group = [
+                (j, other)
+                for j, other in enumerate(transfers)
+                if other.host_pool is t.host_pool
+                and torch.equal(other.host_indices, t.host_indices)
+                and torch.equal(other.device_indices, t.device_indices)
+            ]
+            covered = []
+            for j, other in group:
+                if type(t.host_pool) is MLATokenToKVPoolHost:
+                    owners = (
+                        t.host_pool.device_pool,
+                        *t.host_pool.mtp_draft_device_pools,
+                    )
+                    if not any(other.device_pool is owner for owner in owners):
+                        covered = []
+                        break
+                mapping = [
+                    other.layer_mapper(n) if other.layer_mapper is not None else n
+                    for n in range(layer_num)
+                ]
+                covered.extend(x for x in mapping if x is not None)
+            if sorted(covered) != list(range(t.host_pool.layer_num)):
+                continue
+            self._stage(t, "H2D").transfer(
+                t.host_indices, t.device_indices, restore=True
+            )
+            preloaded.update(j for j, _ in group)
+            self._log_once(type(t.host_pool).__name__ + "-pooled-H2D")
+        clone_sources = {}
+        if not self.clone_enabled:
+            return preloaded, clone_sources
+        candidates = []
+        invalid_pools = set()
+        destinations = {}
+        # Deduplicate only when all GDN destinations in a pool are disjoint.
+        # Otherwise an intervening transfer could overwrite the clone source.
+        for i, t in enumerate(transfers):
+            if type(t.host_pool) is not MambaPoolHost:
+                continue
+            pool = t.device_pool
+            eligible = (
+                t.host_pool.device_pool is pool
+                and not t.is_draft
+                and t.host_pool.layout in ("page_first", "page_first_direct")
+                and t.host_indices.device.type == t.device_indices.device.type == "cpu"
+            )
+            if not eligible:
+                invalid_pools.add(id(pool))
+                continue
+            hi = tuple(t.host_indices.tolist())
+            di = tuple(t.device_indices.tolist())
+            assert len(hi) == len(di)
+            owned = set(di)
+            previous = destinations.setdefault(id(pool), set())
+            if len(owned) != len(di) or previous.intersection(owned):
+                invalid_pools.add(id(pool))
+            previous.update(owned)
+            if not hi:
+                continue
+            assert min(hi) >= 0 and max(hi) < t.host_pool.size
+            assert min(di) >= 0 and max(di) < pool.mamba_cache.temporal.shape[1]
+            mapping = tuple(
+                t.layer_mapper(n) if t.layer_mapper is not None else n
+                for n in range(layer_num)
+            )
+            candidates.append((i, t, (id(t.host_pool), id(pool), hi, mapping)))
+        first = {}
+        for i, t, key in candidates:
+            if id(t.device_pool) in invalid_pools:
+                continue
+            if key in first:
+                clone_sources[i] = first[key]
+            else:
+                first[key] = i
+        return preloaded, clone_sources
+
+    def clone_layer(self, source, target, layer):
+        assert source.device_pool is target.device_pool
+        state = target.device_pool.mamba_cache
+        tensors = [state.temporal[layer]] + [conv[layer] for conv in state.conv]
+        transfer_kv_direct(
+            src_layers=tensors,
+            dst_layers=tensors,
+            src_indices=source.device_indices,
+            dst_indices=target.device_indices,
+            page_size=1,
+        )
+        self._log_once("GDN-H2D-then-GPU-clone")
diff --git a/python/sglang/srt/mem_cache/pooled_pages.py b/python/sglang/srt/mem_cache/pooled_pages.py
new file mode 100644
index 0000000000..ffd485cf95
--- /dev/null
+++ b/python/sglang/srt/mem_cache/pooled_pages.py
@@ -0,0 +1,149 @@
+"""Rank-local, byte-preserving staging for page-first HiCache DMA.
+
+A separate persistent allocation per direction belongs to the L2 engine's
+single stream for that direction. CPU data is touched only by CUDA copies;
+Triton kernels gather/scatter device memory. This module owns no cache slots.
+"""
+
+import torch
+import triton
+import triton.language as tl
+from sgl_kernel.kvcacheio import transfer_kv_direct
+from sglang.srt.mem_cache.pool_host.common import (
+    _cuda_managed_prefetch_pages_to_host,
+)
+
+
+@triton.jit
+def _pages_kernel(
+    ptrs,
+    pages,
+    staging,
+    ROW: tl.constexpr,
+    LAYERS: tl.constexpr,
+    BLOCK: tl.constexpr,
+    RESTORE: tl.constexpr,
+):
+    item = tl.program_id(0)
+    page = item // LAYERS
+    layer = item % LAYERS
+    offset = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    device_page = tl.load(pages + page)
+    base = tl.load(ptrs + layer).to(tl.pointer_type(tl.uint8))
+    device_ptr = base + device_page.to(tl.int64) * ROW + offset
+    staging_ptr = staging + item.to(tl.int64) * ROW + offset
+    if RESTORE:
+        data = tl.load(staging_ptr, offset < ROW, 0)
+        tl.store(device_ptr, data, offset < ROW)
+    else:
+        data = tl.load(device_ptr, offset < ROW, 0)
+        tl.store(staging_ptr, data, offset < ROW)
+
+
+class PooledPages:
+    def __init__(self, buffers, host, *, tokens_per_page, staging_pages=64):
+        assert buffers and 1 <= staging_pages <= 128
+        assert host.device.type == "cpu" and host.is_contiguous()
+        assert all(b.is_cuda and b.is_contiguous() for b in buffers)
+        assert len({b.device for b in buffers}) == 1
+        self.layers = len(buffers)
+        assert host.shape[1] == self.layers
+        self.host = host.view(torch.uint8).view(host.shape[0], self.layers, -1)
+        self.row_bytes = self.host.shape[2]
+        assert all(b.nbytes % self.row_bytes == 0 for b in buffers)
+        self.device_page_count = min(b.nbytes // self.row_bytes for b in buffers)
+        self.device = buffers[0].device
+        self.buffers = buffers
+        # Keep the original tensor because torch views do not preserve the
+        # managed-allocation owner attribute used by the HCC allocator.
+        self.host_allocation = host
+        self.ptrs = torch.tensor(
+            [b.data_ptr() for b in buffers], dtype=torch.uint64, device=self.device
+        )
+        self.staging = torch.empty(
+            (staging_pages, self.layers, self.row_bytes),
+            dtype=torch.uint8,
+            device=self.device,
+        )
+        self.capacity = staging_pages
+        self.tokens_per_page = tokens_per_page
+        self.local_pages = torch.arange(staging_pages, dtype=torch.int64)
+        self.calls = self.bytes = self.pages = 0
+
+    def _indices(self, host_indices, device_indices, restore):
+        p = self.tokens_per_page
+        assert host_indices.device.type == device_indices.device.type == "cpu"
+        assert host_indices.dtype == device_indices.dtype == torch.int64
+        assert host_indices.numel() == device_indices.numel()
+        assert host_indices.numel() % p == 0
+        result = []
+        offsets = torch.arange(p, dtype=torch.int64)
+        for indices, limit in (
+            (host_indices, self.host.shape[0]),
+            (device_indices, self.device_page_count),
+        ):
+            blocks = indices.reshape(-1, p)
+            starts = blocks[:, 0]
+            assert bool((starts % p == 0).all())
+            assert torch.equal(blocks, starts[:, None] + offsets)
+            pages = starts // p
+            if pages.numel():
+                assert int(pages.min()) >= 0 and int(pages.max()) < limit
+            result.append(pages)
+        destination = result[1 if restore else 0]
+        assert destination.unique().numel() == destination.numel(), (
+            "overlapping DMA destinations"
+        )
+        return result
+
+    def transfer(self, host_indices, device_indices, *, restore):
+        host_pages, device_pages = self._indices(host_indices, device_indices, restore)
+        if not host_pages.numel():
+            return
+        gpu_pages = device_pages.to(self.device, non_blocking=True)
+        for start in range(0, len(host_pages), self.capacity):
+            count = min(self.capacity, len(host_pages) - start)
+            local = self.local_pages[:count]
+            selected_host = host_pages[start : start + count]
+            grid = (count * self.layers, triton.cdiv(self.row_bytes, 1024))
+            if restore:
+                transfer_kv_direct(
+                    src_layers=[self.host],
+                    dst_layers=[self.staging],
+                    src_indices=selected_host,
+                    dst_indices=local,
+                    page_size=1,
+                )
+            _pages_kernel[grid](
+                self.ptrs,
+                gpu_pages[start : start + count],
+                self.staging,
+                self.row_bytes,
+                self.layers,
+                1024,
+                restore,
+            )
+            if not restore:
+                transfer_kv_direct(
+                    src_layers=[self.staging],
+                    dst_layers=[self.host],
+                    src_indices=local,
+                    dst_indices=selected_host,
+                    page_size=1,
+                )
+            # GPU access to cudaMallocManaged memory can migrate dirtied/read
+            # host pages into HBM even with a CPU preferred-location hint.
+            # Enqueue the return migration after this chunk's final consumer
+            # on the same stream, coalescing adjacent page ranges in common.py.
+            _cuda_managed_prefetch_pages_to_host(
+                self.host_allocation,
+                selected_host,
+                self.layers * self.row_bytes,
+                torch.cuda.current_stream(self.device),
+            )
+        self.calls += 1
+        self.pages += len(host_pages)
+        self.bytes += len(host_pages) * self.layers * self.row_bytes
+        self.staging.record_stream(torch.cuda.current_stream(self.device))
+        self.ptrs.record_stream(torch.cuda.current_stream(self.device))
+        gpu_pages.record_stream(torch.cuda.current_stream(self.device))
diff --git a/python/sglang/srt/mem_cache/startup_ram_budget.py b/python/sglang/srt/mem_cache/startup_ram_budget.py
new file mode 100644
index 0000000000..50d586af64
--- /dev/null
+++ b/python/sglang/srt/mem_cache/startup_ram_budget.py
@@ -0,0 +1,233 @@
+"""One startup RAM budget for a single-node TP hybrid HiCache replica.
+
+This downstream opt-in sizes existing fixed pools; it does not resize them at
+runtime. All ranks rendezvous after model loading and before host allocation.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import re
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from decimal import Decimal
+from pathlib import Path, PurePosixPath
+
+ENV = "SGLANG_HICACHE_RAM_BUDGET"
+RESERVE_BYTES = 10 * 1024**3
+logger = logging.getLogger(__name__)
+_active: ContextVar[RankBudget | None] = ContextVar("hicache_ram_budget", default=None)
+
+
+def parse_budget(value: str) -> tuple[str, Decimal]:
+    match = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)(%|GB|GiB)", value)
+    if match is None:
+        raise ValueError(f"{ENV} must be a percentage, GB or GiB (e.g. 80% or 256GiB)")
+    amount, unit = Decimal(match[1]), match[2]
+    if amount <= 0 or (unit == "%" and amount >= 100):
+        raise ValueError(f"{ENV} must be positive; percentages must be below 100%")
+    return unit, amount
+
+
+def _unescape_mount(value: str) -> str:
+    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), value)
+
+
+def cgroup_headrooms(proc: Path = Path("/proc")) -> list[int]:
+    """Read hard memory headroom at every visible ancestor, v2 or v1.
+
+    Resolve both namespaced and host cgroup mounts. Do not count swap or assume
+    page cache is reclaimable. Hidden ancestors cannot be inspected: the CVM's
+    MemAvailable remains an independent cap. Fail on unreadable active limits.
+    """
+    groups = {}
+    for line in (proc / "self/cgroup").read_text().splitlines():
+        _, controllers, path = line.split(":", 2)
+        if controllers == "":
+            groups["cgroup2"] = path
+        elif "memory" in controllers.split(","):
+            groups["cgroup"] = path
+    if not groups:
+        return []
+    headrooms, found = [], False
+    for line in (proc / "self/mountinfo").read_text().splitlines():
+        fields, tail = line.split(" - ", 1)
+        fields, tail = fields.split(), tail.split()
+        kind = tail[0]
+        if kind not in groups or (
+            kind == "cgroup" and "memory" not in tail[2].split(",")
+        ):
+            continue
+        root = PurePosixPath(_unescape_mount(fields[3]))
+        mount = Path(_unescape_mount(fields[4]))
+        membership = PurePosixPath(groups[kind])
+        if ".." in membership.parts:
+            raise ValueError("Cannot resolve cgroup memory path containing '..'")
+        try:
+            relative = membership.relative_to(root)
+        except ValueError:
+            continue
+        directory = mount / str(relative)
+        found = True
+        while True:
+            limit_file = "memory.max" if kind == "cgroup2" else "memory.limit_in_bytes"
+            usage_file = (
+                "memory.current" if kind == "cgroup2" else "memory.usage_in_bytes"
+            )
+            # A v2 root or ancestor without the memory controller has no files.
+            # Any existing pair must be readable and valid; never ignore errors.
+            limit_path = directory / limit_file
+            if limit_path.exists():
+                raw = limit_path.read_text().strip()
+                if raw != "max":
+                    limit = int(raw)
+                    usage = int((directory / usage_file).read_text().strip())
+                    if limit < 0 or usage < 0:
+                        raise ValueError("Negative cgroup memory counter")
+                    headrooms.append(max(0, limit - usage))
+            elif (
+                kind == "cgroup"
+                or directory == mount / str(relative)
+                and directory != mount
+            ):
+                raise ValueError(f"Missing cgroup memory controller at {directory}")
+            if directory == mount:
+                break
+            directory = directory.parent
+    if not found:
+        raise ValueError("Cannot locate the process cgroup memory mount")
+    return headrooms
+
+
+def available_ram_bytes() -> int:
+    import psutil
+
+    return max(
+        0, min(psutil.virtual_memory().available, *cgroup_headrooms(), float("inf"))
+    )
+
+
+@dataclass
+class RankBudget:
+    total_bytes: int
+    ranks: int
+    used_bytes: int = 0
+
+    @property
+    def rank_bytes(self) -> int:
+        return self.total_bytes // self.ranks
+
+    @property
+    def remaining_bytes(self) -> int:
+        return self.rank_bytes - self.used_bytes
+
+    def claim(self, requested_bytes: int) -> None:
+        if requested_bytes < 0 or requested_bytes > self.remaining_bytes:
+            raise ValueError("HiCache pools exceed the shared startup RAM budget")
+        self.used_bytes += requested_bytes
+
+
+def resolve_budget(records: list[dict]) -> RankBudget:
+    """All ranks resolve the same cap or fail together before allocating."""
+    errors = [record["error"] for record in records if record["error"]]
+    if errors:
+        raise ValueError(f"HiCache startup RAM sizing failed: {errors}")
+    configs = {record["config"] for record in records}
+    if len(configs) != 1:
+        raise ValueError(f"{ENV} differs across TP ranks")
+    unit, amount = parse_budget(configs.pop())
+    available = min(record["available_bytes"] for record in records)
+    safe = max(0, available - RESERVE_BYTES)
+    if unit == "%":
+        total = min(int(Decimal(available) * amount / 100), safe)
+    else:
+        total = int(amount * (10**9 if unit == "GB" else 1024**3))
+        if total > safe:
+            raise ValueError(f"{ENV} exceeds available RAM minus the 10 GiB reserve")
+    if total // len(records) <= 0:
+        raise ValueError("No RAM available for HiCache after the 10 GiB reserve")
+    return RankBudget(total, len(records))
+
+
+def active_budget() -> RankBudget | None:
+    return _active.get()
+
+
+def reserve_startup_bytes(requested_bytes: int) -> None:
+    if (budget := active_budget()) is not None:
+        budget.claim(requested_bytes)
+
+
+def host_page_count(tokens: int, page_size: int) -> int:
+    if active_budget() is None:
+        return tokens // page_size + 1  # Preserve upstream behavior without opt-in.
+    pages = tokens // page_size  # Never exceed the budget through page rounding.
+    if pages < 1:
+        raise ValueError("HiCache RAM budget is too small for one page/state per pool")
+    return pages
+
+
+@contextmanager
+def startup_ram_budget(*, supported: bool):
+    config = os.environ.get(ENV)
+    if config is None:
+        yield
+        return
+
+    import torch.distributed as dist
+
+    from sglang.srt.distributed.parallel_state import get_world_group
+    from sglang.srt.runtime_context import get_context, get_memory, get_parallel
+
+    world = get_world_group()
+    parallel = get_parallel()
+    # The supported deployment is one TP replica in one CVM. A world group
+    # must not mix independent DP replicas or machines with different RAM.
+    group = world.cpu_group
+    dist.barrier(group=group)
+    record = {"config": config, "available_bytes": 0, "error": None}
+    try:
+        parse_budget(config)
+        if (
+            not supported
+            or parallel.nnodes != 1
+            or world.world_size != parallel.tp_size
+        ):
+            raise ValueError(
+                "RAM budget supports a single-node TP hybrid KV+Mamba stack only"
+            )
+        if parallel.pp_size != 1 or parallel.dp_size != 1 or parallel.dcp_enabled:
+            raise ValueError("RAM budget does not support PP, DP or DCP")
+        if get_memory().hicache_size > 0:
+            raise ValueError(f"Use {ENV} OR --hicache-size, not both")
+        if get_memory().hicache_storage_backend is not None:
+            raise ValueError("RAM budget currently supports in-CVM host RAM only")
+        record["available_bytes"] = available_ram_bytes()
+    except Exception as exc:
+        record["error"] = str(exc)
+    records = [None] * world.world_size
+    dist.all_gather_object(records, record, group=group)
+    budget = resolve_budget(records)
+    get_context().override(source=ENV, hicache_size=budget.rank_bytes / 1e9)
+    logger.info(
+        "HiCache startup RAM: config=%s available_bytes=%d total_budget_bytes=%d "
+        "ranks=%d rank_budget_bytes=%d reserve_bytes=%d",
+        config,
+        min(r["available_bytes"] for r in records),
+        budget.total_bytes,
+        budget.ranks,
+        budget.rank_bytes,
+        RESERVE_BYTES,
+    )
+    token = _active.set(budget)
+    try:
+        yield budget
+        logger.info(
+            "HiCache startup RAM allocated: rank_pool_bytes=%d rank_budget_bytes=%d",
+            budget.used_bytes,
+            budget.rank_bytes,
+        )
+    finally:
+        _active.reset(token)
