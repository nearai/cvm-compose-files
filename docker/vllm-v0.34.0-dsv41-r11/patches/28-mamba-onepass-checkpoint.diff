+def mamba_prefill_checkpoint_needs_fresh_row(
+    query_start: int,
+    query_end: int,
+    mamba_block_size: int,
+) -> bool:
+    """Whether a valid checkpoint lands strictly before the initial-state
+    column (vllm#60888 shape; the ``==`` case is #66938's resumed block).
+
+    The target is then a skipped (null) slot. A running request's worker
+    block-table row is append-only and may hold a stale block id there, so
+    such a checkpoint is only scheduled for a row the worker receives whole
+    this step (a request's first chunk).
+    """
+    initial_state_col = (query_start - 1) // mamba_block_size
+    checkpoint_col = cdiv(query_end, mamba_block_size) - 2
+    return checkpoint_col < initial_state_col
 
 
