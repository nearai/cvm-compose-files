+    def _mamba_relax_end(
+        self,
+        request: Request,
+        start: int,
+        end: int,
+        next_block_boundary: int,
+        relax_running: bool,
+    ) -> int:
+        """End of a non-final chunk under VLLM_MAMBA_RELAX_ALIGN.
+
+        Stock ends a non-final chunk on a block boundary and schedules nothing
+        (the waiting loop then stops) when the budget does not reach one. This
+        may also end it at a relaxed position: ``alignment`` past a hash unit
+        (``mamba_relax_residue``), whose state is the request's private running
+        state, never keyed. The chunk resuming there is identifiable to every
+        worker by its start alone; it may cross one block boundary because the
+        backend exports that boundary's state in the same forward
+        (``mamba_relax_boundary_checkpoint``), which the full-block hash keys
+        exactly as an aligned chunk end. Any other start (a prefix hit, a block
+        boundary, the tail stop) keeps the stock rules and never crosses a
+        boundary with a relaxed end, so the prompt-tail rule cannot fire on a
+        running row. Stops applied after this (tail, last cacheable boundary)
+        are unchanged.
+        """
+        block_size = self.cache_config.block_size
+        if relax_running:
+            # At most one boundary inside: the backend exports one state.
+            end = min(end, next_block_boundary + block_size)
+            aligned_end = end // block_size * block_size
+        else:
+            aligned_end = end // block_size * block_size
+            # Stock rule; a relaxed end stays inside the current block.
+            end = min(end, next_block_boundary)
+        limit = end
+        if self.num_prefill_lookahead > 1:
+            # Keep `_reserve_prefill_lookahead` from moving a relaxed end.
+            limit = min(limit, request.num_tokens - self.num_prefill_lookahead)
+        relaxed_end = _kvi.mamba_relax_floor(
+            limit, self.hash_block_size, self.mamba_prefill_checkpoint_alignment
+        )
+        return max(aligned_end, relaxed_end, start)
