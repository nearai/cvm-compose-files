--- a/vllm/v1/kv_cache_interface.py	2026-11-23 17:48:52
+++ b/vllm/v1/kv_cache_interface.py	2026-11-23 17:48:52
@@ -1205,6 +1205,72 @@
 # (backport of vllm#66938 + vllm#60888). Read once at import so the scheduler,
 # MambaManager and the workers (same container env) decide in lockstep.
 MAMBA_ONEPASS_CKPT = os.environ.get("VLLM_MAMBA_ONEPASS_CKPT", "0") == "1"
+# Opt-in (default off, needs MAMBA_ONEPASS_CKPT): relaxed align-mode chunk ends.
+# A non-final prefill chunk may end mid-block at a "relaxed" position, and a
+# chunk starting at one may cross one block boundary, whose state the backend
+# exports in the same forward. Read once at import like the flag above, so the
+# scheduler, MambaManager and the workers decide in lockstep.
+MAMBA_RELAX_ALIGN = (
+    MAMBA_ONEPASS_CKPT and os.environ.get("VLLM_MAMBA_RELAX_ALIGN", "0") == "1"
+)
+
+
+def mamba_relax_residue(
+    hash_block_size: int, checkpoint_alignment: int | None
+) -> int | None:
+    """Residue (mod ``hash_block_size``) of every relaxed chunk end.
+
+    Relaxed ends are ``checkpoint_alignment`` past a hash unit, never on one.
+    Prefix hits and block boundaries are unit-aligned, so a chunk start with
+    this residue identifies a running row that resumed at a relaxed end. The
+    prompt-tail checkpoint rule needs a unit-aligned start, so it never fires
+    for such a row (its worker block table is append-only), and the boundary
+    rule below never fires for any other row.
+    """
+    if (
+        not MAMBA_RELAX_ALIGN
+        or checkpoint_alignment is None
+        or not 0 < checkpoint_alignment < hash_block_size
+        or hash_block_size % checkpoint_alignment
+    ):
+        return None
+    return checkpoint_alignment
+
+
+def mamba_relax_floor(
+    position: int, hash_block_size: int, checkpoint_alignment: int | None
+) -> int:
+    """The largest relaxed chunk end at or below ``position`` (or -1)."""
+    residue = mamba_relax_residue(hash_block_size, checkpoint_alignment)
+    if residue is None or position < residue:
+        return -1
+    return (position - residue) // hash_block_size * hash_block_size + residue
+
+
+def mamba_relax_boundary_checkpoint(
+    query_start: int,
+    query_end: int,
+    mamba_block_size: int,
+    hash_block_size: int,
+    checkpoint_alignment: int | None,
+) -> int:
+    """Block boundary whose state a relaxed-start row exports in-forward, or 0.
+
+    Applies only to a row starting at a relaxed end (see
+    ``mamba_relax_residue``). The boundary is the last block boundary strictly
+    inside the query; the scheduler never lets such a row cross two. The state
+    goes to column ``boundary // mamba_block_size - 1``, which equals the tail
+    rule's ``cdiv(query_end, mamba_block_size) - 2``: the request's own running
+    block (pre-copied into the next column before the forward overwrites it).
+    """
+    residue = mamba_relax_residue(hash_block_size, checkpoint_alignment)
+    if residue is None or query_start % hash_block_size != residue:
+        return 0
+    assert checkpoint_alignment is not None
+    boundary = (query_end - 1) // mamba_block_size * mamba_block_size
+    if boundary <= query_start or (boundary - query_start) % checkpoint_alignment:
+        return 0
+    return boundary
 
 
