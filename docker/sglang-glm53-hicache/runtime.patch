+from sglang.srt.mem_cache.pool_host.mla import MLATokenToKVPoolHost
+from sglang.srt.mem_cache.pool_host.mamba import MambaPoolHost
+from sglang.srt.mem_cache.memory_pool_host import DeepSeekV4PagedHostPool
+
+logger = logging.getLogger(__name__)
+
+
+class PooledL2:
+    def __init__(self, io_backend):
+        assert io_backend == "direct"
+        assert torch.cuda.is_available() and torch.version.hip is None
+        self.backup_enabled = self.restore_enabled = self.clone_enabled = True
+        self.pages = int(os.environ.get("SGLANG_HICACHE_STAGING_PAGES", "64"))
+        assert 1 <= self.pages <= 128
+        self.staging = {}
+        self.logged = set()
+
+    def _log_once(self, name):
+        if name not in self.logged:
+            logger.info("Pooled L2 transfer executed: %s", name)
+            self.logged.add(name)
+
+    @staticmethod
+    def _buffers(t):
+        h, d = t.host_pool, t.device_pool
+        if h.layout != "page_first_direct" or getattr(h, "dcp_size", 1) != 1:
+            return None
+        if t.host_indices.device.type != "cpu" or t.device_indices.device.type != "cpu":
+            return None
+        if type(h) is MLATokenToKVPoolHost and isinstance(d, MLATokenToKVPool):
+            if h.device_pool is not d or h._is_device_layer_sharded(d):
+                return None
+            _, buffers = h._resolve_device_transfer_buffers(d)
+            if len(buffers) != h.layer_num:
+                return None
+            if any(
+                b.shape[0] % h.page_size
+                or b[0].nbytes != h.kv_cache_dim * h.dtype.itemsize
+                for b in buffers
+            ):
+                return None
+            return buffers
+        if type(h) is DeepSeekV4PagedHostPool and h.page_aligned_only:
+            if any(
+                b.ndim != 2 or b.shape[1] * b.element_size() != h.item_bytes
+                for b in h.device_buffers
+            ):
+                return None
+            return h.device_buffers
+        return None
