+"""Synthetic exact-byte checks on all four ranks, plus a NCCL collective."""
+
+import os
+import json
+import torch
+import torch.distributed as dist
+from test_hicache_draft_sidecar_gpu import run_case
+from test_pooled_packed_mtp import run_packed
+from sglang.srt.mem_cache.pooled_pages import PooledPages
+
+
+def check_pages(rank):
+    gen = torch.Generator().manual_seed(5353 + rank)
+    # More than one staging chunk, shuffled sparse addresses, raw BF16 and
+    # packed index rows. Target+MTP are carried as twelve attention layers.
+    for layers, row, dtype in [
+        (12, 64 * 512 * 2, torch.bfloat16),
+        (7, 64 * 132, torch.uint8),
+    ]:
+        dev = [
+            torch.empty((96, row // dtype.itemsize), dtype=dtype, device="cuda")
+            for _ in range(layers)
+        ]
+        original = [
+            torch.randint(0, 256, (96, row), dtype=torch.uint8, generator=gen)
+            for _ in dev
+        ]
+        for d, o in zip(dev, original):
+            d.view(torch.uint8).copy_(o)
+        host = torch.empty((192, layers, 1, row), dtype=torch.uint8, pin_memory=True)
+        down = PooledPages(dev, host, tokens_per_page=64, staging_pages=7)
+        up = PooledPages(dev, host, tokens_per_page=64, staging_pages=7)
+        src = torch.randperm(96, generator=gen)[:73]
+        hp = torch.randperm(192, generator=gen)[:73]
+        dst = torch.randperm(96, generator=gen)[:73]
+        tokens = lambda p: (p[:, None] * 64 + torch.arange(64)).flatten()
+        ds, hs = torch.cuda.Stream(), torch.cuda.Stream()
+        ds.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(ds):
+            down.transfer(tokens(hp[:31]), tokens(src[:31]), restore=False)
+            down.transfer(tokens(hp[31:]), tokens(src[31:]), restore=False)
+            done = ds.record_event()
+        torch.cuda.current_stream().wait_event(done)
+        for d in dev:
+            d.view(torch.uint8).fill_(173)
+        hs.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(hs):
+            up.transfer(tokens(hp), tokens(dst), restore=True)
+            done = hs.record_event()
+        done.synchronize()
+        for layer, (d, o) in enumerate(zip(dev, original)):
+            assert torch.equal(d.view(torch.uint8).cpu()[dst], o[src]), (
+                rank,
+                layer,
+                row,
+            )
+            assert torch.equal(host[:, layer, 0][hp], o[src]), (
+                "host",
+                rank,
+                layer,
+                row,
+            )
+        print(
+            json.dumps(
+                {
+                    "rank": rank,
+                    "kind": "pooled_pages",
+                    "layers": layers,
+                    "bytes_each_direction": layers * 73 * row,
+                    "passed": True,
+                }
+            ),
+            flush=True,
+        )
+    run_packed()
+    # Mixed draft geometry forces separate KV/index sidecars; exercises the
+    # actual L2 engine plan and all-layer completion rather than only a kernel.
+    for live in (False, True):
+        run_case(
+            "page_first_direct",
+            "direct",
+            (torch.float8_e4m3fn, 656),
+            (torch.bfloat16, 576),
+            True,
+            live,
+            True,
+        )
+
+
+if __name__ == "__main__":
+    rank = int(os.environ["LOCAL_RANK"])
+    torch.cuda.set_device(rank)
+    dist.init_process_group("nccl")
+    with torch.inference_mode():
+        check_pages(rank)
+    count = torch.tensor(1, device="cuda")
+    dist.all_reduce(count)
+    assert count.item() == 4
+    print(json.dumps({"rank": rank, "all_four_ranks_passed": True}), flush=True)
+    dist.destroy_process_group()
