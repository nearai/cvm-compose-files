+"""Byte-exact recurrent-state cloning with GLM's TP4 head geometry."""
+
+import json
+import torch
+from sglang.srt.configs.mamba_utils import KimiLinearStateShape, KimiLinearCacheParams
+from sglang.srt.mem_cache.memory_pool import MambaPool
+from sglang.srt.mem_cache.pool_host.mamba import MambaPoolHost
+from sglang.srt.mem_cache.l2_transfer import L2Transfer, L2TransferEngine
+from sglang.srt.runtime_context import publish, reset_context
+from sglang.srt.server_args import ServerArgs
+
+
+def main():
+    publish(ServerArgs(model_path="dummy"), role="scheduler")
+    shape = KimiLinearStateShape.create(
+        tp_world_size=4, num_heads=64, head_dim=128, conv_kernel_size=4
+    )
+    layer_ids = list(range(34))
+    pool = MambaPool(
+        size=8,
+        spec_state_size=0,
+        cache_params=KimiLinearCacheParams(shape=shape, layers=layer_ids),
+        mamba_layer_ids=layer_ids,
+        device="cuda",
+    )
+    host = MambaPoolHost(pool, 2, 0, layout="page_first_direct")
+    gen = torch.Generator().manual_seed(53534)
+    originals = []
+    for b in [pool.mamba_cache.temporal, *pool.mamba_cache.conv]:
+        view = b.view(torch.uint8)
+        original = torch.randint(0, 256, view.shape, dtype=torch.uint8, generator=gen)
+        view.copy_(original)
+        originals.append(original)
+    hi = torch.tensor([2])
+    src = torch.tensor([1])
+    dst = torch.tensor([4])
+    clone = torch.tensor([6])
+    mapper = lambda layer: layer
+    engine = L2TransferEngine("direct")
+    assert engine._pooled_io
+    completion = engine.submit_device_to_host([L2Transfer(host, pool, hi, src, mapper)])
+    torch.cuda.current_stream().wait_event(completion.finish_event)
+    for b in [pool.mamba_cache.temporal, *pool.mamba_cache.conv]:
+        b.view(torch.uint8).fill_(173)
+    completion = engine.submit_host_to_device(
+        [
+            L2Transfer(host, pool, hi, dst, mapper),
+            L2Transfer(host, pool, hi, clone, mapper),
+        ],
+        layer_num=34,
+    )
+    completion.finish_event.synchronize()
+    compared = 0
+    for b, o in zip([pool.mamba_cache.temporal, *pool.mamba_cache.conv], originals):
+        got = b.view(torch.uint8).cpu()
+        for dest in (dst, clone):
+            assert torch.equal(got[:, dest], o[:, src])
+            compared += got[:, dest].numel()
+    assert "GDN-H2D-then-GPU-clone" in engine._pooled_io.logged
+    host.destroy()
+    reset_context()
+    print(
+        json.dumps(
+            {
+                "case": "GLM_KDA_TP4_state_geometry",
+                "layers": 34,
+                "heads_per_rank": 16,
+                "state_dtype": "float32",
+                "convolution_dtype": "bfloat16",
+                "bytes_compared": compared,
+                "passed": True,
+            }
+        ),
+        flush=True,
+    )
+
+
+if __name__ == "__main__":
+    with torch.inference_mode():
+        main()
