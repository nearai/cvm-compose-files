+"""Packed target+MTP HiCache: complete pooled restore before both consumers."""
+
+import torch
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+from test_hicache_draft_sidecar_gpu import make_pool, tokens
+from sglang.srt.mem_cache.pool_host.mla import MLATokenToKVPoolHost
+from sglang.srt.mem_cache.hybrid_cache.hybrid_pool_assembler import (
+    _build_hybrid_dsa_index_entry,
+    build_pool_entry,
+)
+from sglang.srt.mem_cache.hybrid_cache.hybrid_cache_controller import (
+    HybridCacheController,
+)
+from sglang.srt.mem_cache.pool_host import HostPoolGroup
+from sglang.srt.mem_cache.hicache_storage import PoolName, PoolTransfer
+from sglang.srt.mem_cache.l2_transfer import L2TransferEngine
+from sglang.srt.runtime_context import publish, reset_context
+from sglang.srt.server_args import ServerArgs
+
+
+def run_packed():
+    publish(
+        ServerArgs(
+            model_path="dummy",
+            enable_hierarchical_cache=True,
+            hicache_mem_layout="page_first_direct",
+            hicache_io_backend="direct",
+        ),
+        role="scheduler",
+    )
+    target = make_pool(torch.bfloat16, 576, (True, False, True), True)
+    draft = make_pool(torch.bfloat16, 576, (True,), True)
+    host = MLATokenToKVPoolHost(
+        target,
+        2,
+        0,
+        64,
+        "page_first_direct",
+        override_kv_cache_dim=576,
+        mtp_draft_device_pools=(draft,),
+    )
+    mapping = {0: 0, 1: 1, 2: 2, 3: 3}
+    entry = build_pool_entry(
+        name=PoolName.KV,
+        host_pool=host,
+        device_pool=target,
+        layer_mapping=mapping,
+        transfer_layer_num=4,
+        is_anchor=True,
+        packed_draft_device_pools=(draft,),
+    )
+    with patch(
+        "sglang.srt.mem_cache.hybrid_cache.hybrid_pool_assembler._get_allocator_type",
+        return_value="default",
+    ):
+        index = _build_hybrid_dsa_index_entry(
+            kv_pool=target,
+            kv_host_pool=host,
+            layer_mapping=mapping,
+            transfer_layer_num=4,
+            draft_pools=(draft,),
+        )
+    controller = object.__new__(HybridCacheController)
+    controller.mem_pool_host = HostPoolGroup([entry, index])
+    controller.layer_num = 3
+    srcpages = torch.tensor([0, 1, 2, 3, 8, 9, 10, 11])
+    dstpages = torch.tensor([12, 13, 14, 15, 4, 5, 6, 7])
+    hostpages = torch.tensor([16, 17, 18, 19, 4, 5, 6, 7])
+    src, dst, hi = [tokens(x) for x in (srcpages, dstpages, hostpages)]
+    original = []
+    gen = torch.Generator().manual_seed(53531)
+    for pool in (target, draft):
+        for is_index, buffers in [
+            (False, pool.kv_buffer),
+            (True, pool.index_k_with_scale_buffer),
+        ]:
+            for b in buffers:
+                if not b.numel():
+                    continue
+                view = b.view(torch.uint8)
+                expected = torch.randint(
+                    0, 256, view.shape, dtype=torch.uint8, generator=gen
+                )
+                view.copy_(expected)
+                original.append((view, expected, is_index))
+
+    def transfers(h, d):
+        return controller._l2_load_transfers(
+            h,
+            d,
+            [
+                PoolTransfer(
+                    PoolName.INDEXER,
+                    host_indices=h,
+                    device_indices=d,
+                    indices_from_pool=PoolName.KV,
+                )
+            ],
+        )
+
+    # Backups have one descriptor per host pool, not per draft consumer.
+    down = controller._l2_transfers(
+        hi,
+        src,
+        [
+            PoolTransfer(
+                PoolName.INDEXER,
+                host_indices=hi,
+                device_indices=src,
+                indices_from_pool=PoolName.KV,
+            )
+        ],
+    )
+    engine = L2TransferEngine("direct")
+    assert engine._pooled_io
+    completion = engine.submit_device_to_host(down)
+    torch.cuda.current_stream().wait_event(completion.finish_event)
+    for b, _, _ in original:
+        b.fill_(173)
+    callbacks = []
+    up = transfers(hi, dst)
+    assert len(up) == 4
+    # Count fallback calls; all target/draft KV/index rows must use staging.
+    with (
+        patch.object(
+            host,
+            "load_to_device_per_layer",
+            side_effect=AssertionError("KV restore fell back"),
+        ),
+        patch.object(
+            index.host_pool,
+            "load_to_device_per_layer",
+            side_effect=AssertionError("index restore fell back"),
+        ),
+    ):
+        completion = engine.submit_host_to_device(
+            up, layer_num=3, on_layer_done=callbacks.append
+        )
+    completion.finish_event.synchronize()
+    assert callbacks == [0, 1, 2]
+    for b, expected, is_index in original:
+        assert torch.equal(
+            b.cpu()[dstpages if is_index else dst],
+            expected[srcpages if is_index else src],
+        )
+    for e in controller.mem_pool_host.entries:
+        e.host_pool.destroy()
+    reset_context()
+    print(
+        "Packed target+MTP KV+index pooled restore: all bytes and both consumer descriptors passed",
+        flush=True,
+    )
