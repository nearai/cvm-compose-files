+class _CudaManagedAllocation:
+    """Own a cudaMallocManaged allocation backing a CPU torch tensor."""
+
+    def __init__(self, cudart, ptr: int, size: int, backing) -> None:
+        self.cudart = cudart
+        self.ptr = ptr
+        self.size = size
+        self.backing = backing
+
+    def release(self) -> None:
+        if not self.ptr:
+            return
+        ptr, self.ptr = self.ptr, 0
+        rc = self.cudart.cudaFree(ctypes.c_void_p(ptr))
+        if int(rc) != 0:
+            logger.warning(
+                "cudaFree failed for managed HiCache allocation "
+                "(rc=%d, %s) ptr=%#x size=%d",
+                int(rc),
+                _cuda_error_string(self.cudart, rc),
+                ptr,
+                self.size,
+            )
+
+    def __del__(self) -> None:
+        try:
+            self.release()
+        except Exception:
+            logger.exception("Failed to release managed HiCache allocation")
