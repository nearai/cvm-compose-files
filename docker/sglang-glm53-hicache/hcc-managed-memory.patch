+def _alloc_cuda_managed(dims: tuple, dtype: torch.dtype, device: str) -> torch.Tensor:
+    """Allocate host-visible Unified Memory for HCC where pinning is unsupported."""
+
+    if device != "cpu":
+        raise ValueError(
+            "Managed HiCache allocation only supports CPU host tensors; "
+            f"got device={device!r}"
+        )
+    numel = math.prod(dims)
+    element_size = torch.empty((), dtype=dtype, device="cpu").element_size()
+    size = numel * element_size
+    if size <= 0:
+        raise ValueError(f"Managed HiCache allocation size must be positive; got {size}")
+
+    cudart = _load_cudart()
+    raw_ptr = ctypes.c_void_p()
+    rc = cudart.cudaMallocManaged(ctypes.byref(raw_ptr), size, 1)
+    if int(rc) != 0:
+        raise RuntimeError(
+            "cudaMallocManaged failed for HiCache host allocation "
+            f"(rc={int(rc)}, {_cuda_error_string(cudart, rc)}) size={size}"
+        )
+    ptr = int(raw_ptr.value or 0)
+    try:
+        current_device = ctypes.c_int()
+        rc = cudart.cudaGetDevice(ctypes.byref(current_device))
+        if int(rc) != 0:
+            raise RuntimeError(
+                "cudaGetDevice failed while configuring managed HiCache memory "
+                f"(rc={int(rc)}, {_cuda_error_string(cudart, rc)})"
+            )
+        for advice, location, description in (
+            (
+                _CUDA_MEM_ADVISE_SET_PREFERRED_LOCATION,
+                _CudaMemLocation(_CUDA_MEM_LOCATION_TYPE_HOST, 0),
+                "CPU preferred location",
+            ),
+            (
+                _CUDA_MEM_ADVISE_SET_ACCESSED_BY,
+                _CudaMemLocation(
+                    _CUDA_MEM_LOCATION_TYPE_DEVICE, int(current_device.value)
+                ),
+                "current GPU access",
+            ),
+        ):
+            rc = cudart.cudaMemAdvise(ctypes.c_void_p(ptr), size, advice, location)
+            if int(rc) != 0:
+                raise RuntimeError(
+                    f"cudaMemAdvise failed for {description} on managed "
+                    "HiCache memory "
+                    f"(rc={int(rc)}, {_cuda_error_string(cudart, rc)}) "
+                    f"ptr={ptr:#x} size={size} location_type={location.type} "
+                    f"location_id={location.id}"
+                )
+        backing = (ctypes.c_ubyte * size).from_address(ptr)
+        byte_buffer = torch.frombuffer(backing, dtype=torch.uint8, count=size)
+        buffer = byte_buffer.view(dtype).view(dims)
+    except Exception:
+        cudart.cudaFree(ctypes.c_void_p(ptr))
+        raise
+
+    owner = _CudaManagedAllocation(cudart, ptr, size, backing)
+    setattr(buffer, _CUDA_MANAGED_ALLOCATION_ATTR, owner)
+    # The normal pool destroy path calls _cuda_host_unregister. An explicit
+    # empty list records that this allocation was never host-registered.
+    setattr(buffer, _CUDA_HOST_REGISTERED_RANGES_ATTR, [])
+    logger.info(
+        "Allocated %.2f GiB CUDA managed memory for HiCache because %s=1; "
+        "preferred_location=cpu accessed_by_device=%d; cudaHostRegister is not used",
+        size / 1024**3,
+        _CUDA_MANAGED_MEMORY_ENV,
+        int(current_device.value),
+    )
+    return buffer
+
