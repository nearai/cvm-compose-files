+def _alloc_cuda_host(dims: tuple, dtype: torch.dtype, device: str) -> torch.Tensor:
+    """Allocate CUDA-owned pinned host memory without cudaHostRegister."""
+
+    if device != "cpu":
+        raise ValueError(
+            "CUDA-owned HiCache host allocation only supports CPU tensors; "
+            f"got device={device!r}"
+        )
+    numel = math.prod(dims)
+    element_size = torch.empty((), dtype=dtype, device="cpu").element_size()
+    size = numel * element_size
+    if size <= 0:
+        raise ValueError(
+            f"CUDA-owned HiCache host allocation size must be positive; got {size}"
+        )
+
+    cudart = _load_cudart()
+    raw_ptr = ctypes.c_void_p()
+    rc = cudart.cudaMallocHost(ctypes.byref(raw_ptr), size)
+    if int(rc) != 0:
+        raise RuntimeError(
+            "cudaMallocHost failed for HiCache host allocation "
+            f"(rc={int(rc)}, {_cuda_error_string(cudart, rc)}) size={size}"
+        )
+    ptr = int(raw_ptr.value or 0)
+    try:
+        backing = (ctypes.c_ubyte * size).from_address(ptr)
+        byte_buffer = torch.frombuffer(backing, dtype=torch.uint8, count=size)
+        buffer = byte_buffer.view(dtype).view(dims)
+    except Exception:
+        cudart.cudaFreeHost(ctypes.c_void_p(ptr))
+        raise
+
+    owner = _CudaHostAllocation(cudart, ptr, size, backing)
+    setattr(buffer, _CUDA_HOST_ALLOCATION_ATTR, owner)
+    # CUDA owns and pins these pages at allocation time. They were never
+    # registered, so the normal pool destroy path must not unregister them.
+    setattr(buffer, _CUDA_HOST_REGISTERED_RANGES_ATTR, [])
+    logger.info(
+        "Allocated %.2f GiB CUDA-owned pinned host memory for HiCache because "
+        "%s=1; cudaHostRegister and Unified Memory are not used",
+        size / 1024**3,
+        _CUDA_HOST_MEMORY_ENV,
+    )
+    return buffer
 
 
