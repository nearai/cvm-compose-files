+def _load_cudart():
+    """Load the CUDA Runtime C ABI used for CUDA-owned host allocations."""
+
+    cudart = ctypes.CDLL("libcudart.so")
+    cudart.cudaMallocHost.argtypes = [
+        ctypes.POINTER(ctypes.c_void_p),
+        ctypes.c_size_t,
+    ]
+    cudart.cudaMallocHost.restype = ctypes.c_int
+    cudart.cudaFreeHost.argtypes = [ctypes.c_void_p]
+    cudart.cudaFreeHost.restype = ctypes.c_int
+    cudart.cudaMallocManaged.argtypes = [
+        ctypes.POINTER(ctypes.c_void_p),
+        ctypes.c_size_t,
+        ctypes.c_uint,
+    ]
+    cudart.cudaMallocManaged.restype = ctypes.c_int
+    cudart.cudaGetDevice.argtypes = [ctypes.POINTER(ctypes.c_int)]
+    cudart.cudaGetDevice.restype = ctypes.c_int
+    cudart.cudaMemAdvise.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_size_t,
+        ctypes.c_int,
+        _CudaMemLocation,
+    ]
+    cudart.cudaMemAdvise.restype = ctypes.c_int
+    cudart.cudaMemPrefetchAsync.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_size_t,
+        _CudaMemLocation,
+        ctypes.c_uint,
+        ctypes.c_void_p,
+    ]
+    cudart.cudaMemPrefetchAsync.restype = ctypes.c_int
+    cudart.cudaFree.argtypes = [ctypes.c_void_p]
+    cudart.cudaFree.restype = ctypes.c_int
+    cudart.cudaGetErrorString.argtypes = [ctypes.c_int]
+    cudart.cudaGetErrorString.restype = ctypes.c_char_p
