+    """Load the stable CUDA Runtime C ABI used for managed allocations."""
+
+    cudart = ctypes.CDLL("libcudart.so")
+    cudart.cudaMallocManaged.argtypes = [
+        ctypes.POINTER(ctypes.c_void_p),
+        ctypes.c_size_t,
+        ctypes.c_uint,
