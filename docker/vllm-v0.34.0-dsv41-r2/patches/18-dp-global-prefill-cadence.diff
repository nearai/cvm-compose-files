+def dp_prefill_next_interval(interval, clear, any_bound, base, min_interval, restore):
+    """Next prefill release interval, computed identically on every DP rank from
+    all-reduced input: halve if any rank was capacity-bound, else double back to `base`."""
+    if any_bound:
+        return max(min_interval, interval // 2), 0
+    clear += 1
+    if clear >= restore and interval < base:
+        return min(base, interval * 2), 0
+    return interval, min(clear, restore)
+
