diff --git a/python/sglang/srt/mem_cache/kv_cache_configurator.py b/python/sglang/srt/mem_cache/kv_cache_configurator.py
index 84f52dbbf9..d1213156af 100644
--- a/python/sglang/srt/mem_cache/kv_cache_configurator.py
+++ b/python/sglang/srt/mem_cache/kv_cache_configurator.py
@@ -3466,10 +3466,29 @@ def calculate_mla_kv_cache_dim(
             f"kv_lora_rank {kv_lora_rank} must be multiple of quant_block_size {quant_block_size}"
         )
 
+        # NoPE MLA (qk_rope_head_dim == 0, e.g. GLM-5.3) on the FlashMLA fp8
+        # sparse-decode kernels. Those kernels hard-assert the DeepSeek-V3.2
+        # packed row (d_qk == 576, stride_kv_row == 656 bytes: 512 fp8 nope +
+        # 4 fp32 tile scales + 64 bf16 rope), so a rope-less 528-byte row
+        # cannot be consumed. Reserve the 64 rope slots as a structurally
+        # zero region (never written, the pool is zero-initialised; the
+        # attention backend zero-pads q to match). Costs 656 B/token versus
+        # 1024 B/token for bf16 (1.56x pool capacity).
+        rope_slots = qk_rope_head_dim
+        if (
+            qk_rope_head_dim == 0
+            and not _is_hip
+            and "flashmla_kv"
+            in (
+                get_exec().kernel.dsa_prefill_backend,
+                get_exec().kernel.dsa_decode_backend,
+            )
+        ):
+            rope_slots = 64
         return (
             kv_lora_rank
             + kv_lora_rank // quant_block_size * 4
-            + qk_rope_head_dim * rope_storage_dtype.itemsize
+            + rope_slots * rope_storage_dtype.itemsize
         )
 
     return kv_cache_dim
