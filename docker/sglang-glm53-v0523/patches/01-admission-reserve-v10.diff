+def _admission_reserve_need(waiting_queue, page_size, chunked_prefill_size=None):
+    """Sum of page-aligned sizes of waiting requests small enough to fit in the admission reserve (lab port)."""
+    import os as _os
+    cap = int(_os.environ.get("SGLANG_CHUNKED_PREFILL_ADMISSION_RESERVE", "0"))
+    if cap <= 0 or not waiting_queue:
+        return None
+    # v9b: use the same cap the adder will apply (fairness fraction of the chunk, minus one page), so a waiter that
+    # "fits" here also fits at admission; otherwise the reserve is carved for a request that is then skipped.
+    if chunked_prefill_size:
+        max_frac = float(_os.environ.get("SGLANG_ADMISSION_RESERVE_MAX_FRACTION", "0.5"))
+        cap = min(cap, int(chunked_prefill_size * max_frac), max(int(chunked_prefill_size) - page_size, 0))
+        cap = cap // page_size * page_size
+        if cap <= 0:
+            return None
+    need = 0
+    fit_mode = _os.environ.get("SGLANG_ADMISSION_RESERVE_FIT", "extend")  # "extend" = uncached tokens after prefix match; "seqlen" = total
+    # v10 age gate, RANK-DETERMINISTIC: a waiter only triggers the reserve after it has been seen by this scheduler in
+    # >= MIN_ITERS prefill-scheduling passes. Every TP rank runs the same scheduler loop over the same queue, so the
+    # counter is identical on all ranks. (v8/v9 used a wall-clock age via perf_counter: ranks disagreed on who
+    # qualified, built different batches, and the engine died on an NCCL collective mismatch / watchdog timeout.)
+    # 0 = every waiter qualifies immediately (v5-v7 behaviour). Never gate on time here.
+    min_iters = int(_os.environ.get("SGLANG_ADMISSION_RESERVE_MIN_ITERS", "0"))
+    if _os.environ.get("SGLANG_ADMISSION_RESERVE_MIN_WAIT_S"):
+        raise RuntimeError("SGLANG_ADMISSION_RESERVE_MIN_WAIT_S is not rank-deterministic and was removed; use SGLANG_ADMISSION_RESERVE_MIN_ITERS")
+    for r in waiting_queue:
+        if min_iters > 0:
+            seen = getattr(r, "_admission_iters_seen", 0) + 1
+            r._admission_iters_seen = seen
+            if seen < min_iters:
+                continue
+        n = getattr(r, "seqlen", None)
+        if fit_mode == "extend" and n is not None:
+            # v0.5.23: Req.prefix_indices is gone; prefix_len is the device-resident match length set by
+            # match_kv_cache (the same quantity the fork read as len(prefix_indices)).
+            matched = int(getattr(r, "prefix_len", 0) or 0)
+            n = max(n - matched, 1)
+        if n is not None and n <= cap:
+            need += -(-n // page_size) * page_size
+            if need >= cap:
+                break
+    return need or None
+
