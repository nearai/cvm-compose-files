diff --git a/python/sglang/srt/server_args.py b/python/sglang/srt/server_args.py
index 838b925..35713a5 100644
--- a/python/sglang/srt/server_args.py
+++ b/python/sglang/srt/server_args.py
@@ -410,2 +410,36 @@ def add_linear_attn_kernel_backend_choices(choices):
 
+SERVER_ARGS_SECRET_FIELD_NAMES = frozenset(
+    {"api_key", "admin_api_key", "ssl_keyfile_password"}
+)
+_SECRET_CLI_FLAGS = frozenset(
+    "--" + name.replace("_", "-") for name in SERVER_ARGS_SECRET_FIELD_NAMES
+)
+_REDACTED = "<redacted>"
+
+
+def redact_server_args_secrets(values: Dict[str, Any]) -> Dict[str, Any]:
+    redacted = dict(values)
+    for name in SERVER_ARGS_SECRET_FIELD_NAMES:
+        if redacted.get(name) is not None:
+            redacted[name] = _REDACTED
+    return redacted
+
+
+def redact_secret_cli_args(argv: List[str]) -> List[str]:
+    out: List[str] = []
+    hide_next = False
+    for arg in argv:
+        if hide_next:
+            out.append(_REDACTED)
+            hide_next = False
+        elif arg in _SECRET_CLI_FLAGS:
+            out.append(arg)
+            hide_next = True
+        elif "=" in arg and arg.split("=", 1)[0] in _SECRET_CLI_FLAGS:
+            out.append(arg.split("=", 1)[0] + "=" + _REDACTED)
+        else:
+            out.append(arg)
+    return out
+
+
 @dataclasses.dataclass
@@ -2878,2 +2912,16 @@ class ServerArgs:
 
+    def __repr__(self) -> str:
+        values = ", ".join(
+            f"{field.name}="
+            + (
+                repr(_REDACTED)
+                if field.name in SERVER_ARGS_SECRET_FIELD_NAMES
+                and getattr(self, field.name, None) is not None
+                else repr(getattr(self, field.name, None))
+            )
+            for field in dataclasses.fields(self)
+            if field.repr
+        )
+        return f"{type(self).__name__}({values})"
+
     def __post_init__(self):
